@dataclass
class StructureState:
    last_swing_high:     float = math.nan
    last_swing_low:      float = math.nan
    prev_swing_high:     float = math.nan
    prev_swing_low:      float = math.nan
    last_swing_high_rsi: float = math.nan
    last_swing_low_rsi:  float = math.nan
    prev_swing_high_rsi: float = math.nan
    prev_swing_low_rsi:  float = math.nan
    last_pivot_bar:      int   = -999

    bos_level:           float = math.nan
    trend_bias:          str   = "neutral"

    last_signal_bar:     int   = -999
    in_position:         bool  = False
    position_bar:        int   = -999

    def reset_bull(self):
        self.bos_level   = math.nan
        self.trend_bias  = "neutral"
        self.in_position = False

    def reset_bear(self):
        self.bos_level   = math.nan
        self.trend_bias  = "neutral"
        self.in_position = False

    def to_dict(self) -> dict:
        d = asdict(self)
        for k, v in d.items():
            if isinstance(v, float) and math.isnan(v):
                d[k] = None
        return d

    @classmethod
    def from_dict(cls, d: dict) -> "StructureState":
        if not d:
            return cls()
        clean = {}
        for k, v in d.items():
            if v is None and k not in ("trend_bias",):
                clean[k] = math.nan
            else:
                clean[k] = v
        known = {f for f in cls.__dataclass_fields__}
        return cls(**{k: v for k, v in clean.items() if k in known})

    @property
    def has_swing_high(self) -> bool:
        return not math.isnan(self.last_swing_high)

    @property
    def has_swing_low(self) -> bool:
        return not math.isnan(self.last_swing_low)

    @property
    def has_divergence_data(self) -> bool:
        return (
            self.has_swing_high and not math.isnan(self.prev_swing_high) and
            self.has_swing_low  and not math.isnan(self.prev_swing_low)
        )


