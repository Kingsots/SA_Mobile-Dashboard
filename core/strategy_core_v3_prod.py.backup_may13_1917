# CONVENIENCE WRAPPER
# ═══════════════════════════════════════════════════════════════════════════════

def evaluate(
    ticker: str,
    interval: str,
    df_ohlcv: pd.DataFrame,
    min_rows: int = 200,
    config: Optional[V3Config] = None,
) -> SignalResult:
    if df_ohlcv is None or len(df_ohlcv) < min_rows:
        return SignalResult(reason="Insufficient data")
    try:
        engine = SilentStructureEngine(ticker, interval, config)
        return engine.evaluate(df_ohlcv)
    except Exception as e:
        logger.error(f"[V3_EVALUATE] {ticker}-{interval}: {e}")
        return SignalResult(reason=f"Error: {e}")