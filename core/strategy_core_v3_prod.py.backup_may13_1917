# INDICATOR FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════════

def _rsi(series: pd.Series, period: int = 14) -> pd.Series:
    delta = series.diff()
    gain = delta.clip(lower=0)
    loss = (-delta.clip(upper=0))
    avg_gain = gain.ewm(alpha=1.0 / period, adjust=False, min_periods=period).mean()
    avg_loss = loss.ewm(alpha=1.0 / period, adjust=False, min_periods=period).mean()
    rs = avg_gain / avg_loss.replace(0.0, np.nan)
    return (100.0 - (100.0 / (1.0 + rs))).fillna(50.0)


def _ema(series: pd.Series, period: int) -> pd.Series:
    return series.ewm(span=period, adjust=False).mean()


def _atr(df: pd.DataFrame, period: int = 14) -> pd.Series:
    high = df["high"]
    low = df["low"]
    prev_close = df["close"].shift(1)
    tr = pd.concat([
        high - low,
        (high - prev_close).abs(),
        (low - prev_close).abs(),
    ], axis=1).max(axis=1)
    atr = tr.ewm(alpha=1.0 / period, adjust=False, min_periods=period).mean()
    return atr.ffill().fillna(0.0)


def _adx(df: pd.DataFrame, period: int = 14) -> pd.DataFrame:
    high = df["high"]
    low = df["low"]
    close = df["close"]

    up = high.diff()
    down = (-low.diff())

    plus_dm = up.where((up > down) & (up > 0), 0.0)
    minus_dm = down.where((down > up) & (down > 0), 0.0)

    prev_close = close.shift(1)
    tr = pd.concat([
        high - low,
        (high - prev_close).abs(),
        (low - prev_close).abs(),
    ], axis=1).max(axis=1)

    alpha = 1.0 / period
    atr_s = tr.ewm(alpha=alpha, adjust=False, min_periods=period).mean()
    plus_dm_s = plus_dm.ewm(alpha=alpha, adjust=False, min_periods=period).mean()
    minus_dm_s = minus_dm.ewm(alpha=alpha, adjust=False, min_periods=period).mean()

    plus_di = 100.0 * (plus_dm_s / atr_s.replace(0.0, np.nan))
    minus_di = 100.0 * (minus_dm_s / atr_s.replace(0.0, np.nan))

    dx = (abs(plus_di - minus_di) / (plus_di + minus_di).replace(0.0, np.nan)) * 100.0
    adx = dx.ewm(alpha=alpha, adjust=False, min_periods=period).mean()

    result = pd.DataFrame({
        "adx": adx.ffill().fillna(0.0),
        "plus_di": plus_di.ffill().fillna(0.0),
        "minus_di": minus_di.ffill().fillna(0.0),
    }, index=df.index)
    return result


def _pivot_highs(high: pd.Series, lookback: int) -> pd.Series:
    """Left-aligned pivot highs — NO lookahead. Confirmed using rolling max."""
    roll_max = high.rolling(lookback + 1, min_periods=lookback + 1).max()
    is_pivot = high == roll_max
    return high.where(is_pivot)


def _pivot_lows(low: pd.Series, lookback: int) -> pd.Series:
    """Left-aligned pivot lows — NO lookahead."""
    roll_min = low.rolling(lookback + 1, min_periods=lookback + 1).min()
    is_pivot = low == roll_min
    return low.where(is_pivot)


def _get_htf_bias(
    df: pd.DataFrame,
    resample_tf: str = "1H",
    ema_period: int = 100,
    interval: str = None,
) -> tuple[bool, bool]:
    """Higher timeframe bias via resampling — FAIL CLOSED."""
    try:
        idx = df.index
        if idx.tz is None:
            df = df.copy()
            df.index = idx.tz_localize("UTC")
        elif str(idx.tz) != "UTC":
            df = df.copy()
            df.index = idx.tz_convert("UTC")

        # For 4H interval, use native 4H data for HTF bias (don't downsample)
        if interval == '4h':
            df_htf = df.copy()
        else:
            df_htf = df.resample(resample_tf, label="right", closed="right").agg({
                "open": "first",
                "high": "max",
                "low": "min",
                "close": "last",
            }).dropna()

        now_utc = pd.Timestamp.utcnow()
        df_htf = df_htf[df_htf.index <= now_utc]
        if len(df_htf) > 0:
            df_htf = df_htf.iloc[:-1]

        if len(df_htf) < ema_period:
            return False, False

        ema_series = _ema(df_htf["close"], ema_period)
        latest_close = df_htf["close"].iloc[-1]
        latest_ema = ema_series.iloc[-1]

        if pd.isna(latest_ema) or pd.isna(latest_close):
            return False, False

        return (latest_close > latest_ema), (latest_close < latest_ema)

    except Exception as e:
        logger.warning(f"[V3_HTF] Error: {e}")
        return False, False


def _get_daily_bias(df: pd.DataFrame, ema_period: int = 100) -> tuple[bool, bool]:
    """Daily EMA100 bias — FAIL CLOSED."""
    try:
        idx = df.index
        if idx.tz is None:
            df = df.copy()
            df.index = idx.tz_localize("UTC")
        elif str(idx.tz) != "UTC":
            df = df.copy()
            df.index = idx.tz_convert("UTC")

        df_daily = df.resample("D").agg({
            "open": "first",
            "high": "max",
            "low": "min",
            "close": "last",
        }).dropna()

        today_utc = pd.Timestamp.utcnow().normalize()
        df_daily = df_daily[df_daily.index < today_utc]

        if len(df_daily) < ema_period:
            return False, False

        ema_series = _ema(df_daily["close"], ema_period)
        latest_close = df_daily["close"].iloc[-1]
        latest_ema = ema_series.iloc[-1]

        if pd.isna(latest_ema) or pd.isna(latest_close):
            return False, False

        return (latest_close > latest_ema), (latest_close < latest_ema)

    except Exception as e:
        logger.warning(f"[V3_DAILY] Error: {e}")
        return False, False


