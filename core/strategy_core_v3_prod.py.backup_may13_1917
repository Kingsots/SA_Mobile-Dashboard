def backtest(
    df_ohlcv: pd.DataFrame,
    ticker: str,
    interval: str,
    config: Optional[V3Config] = None,
) -> pd.DataFrame:
    cfg = config or get_v3_config(interval)
    engine = SilentStructureEngine(ticker, interval, cfg)

    df = df_ohlcv.copy()
    if df.index.tz is None:
        df.index = df.index.tz_localize("UTC")
    elif str(df.index.tz) != "UTC":
        df.index = df.index.tz_convert("UTC")

    df["rsi"] = _rsi(df["close"], cfg.rsi_period)
    df["ema100"] = _ema(df["close"], cfg.htf_ema_period)
    df["atr"] = _atr(df, cfg.atr_period)
    adx_df = _adx(df, cfg.adx_period)

    ph_series = _pivot_highs(df["high"], cfg.pivot_lookback)
    pl_series = _pivot_lows(df["low"], cfg.pivot_lookback)

    htf_bull, htf_bear = _get_htf_bias(df, cfg.htf_resample, cfg.htf_ema_period, interval=interval)
    daily_bull, daily_bear = _get_daily_bias(df, cfg.htf_ema_period)

    results = []

    for i in range(len(df)):
        if i < engine.MIN_BARS:
            results.append(_null_row(df.index[i]))
            continue

        result = engine._process_bar(
            df=df,
            bar_idx=i,
            ph_series=ph_series,
            pl_series=pl_series,
            adx_df=adx_df,
            htf_bull=htf_bull,
            htf_bear=htf_bear,
            daily_bull=daily_bull,
            daily_bear=daily_bear,
        )

        cr = _evaluate_confluence(
            df=df,
            bar_idx=i,
            state=engine.state,
            adx_df=adx_df,
            cfg=cfg,
            htf_bull=htf_bull,
            htf_bear=htf_bear,
            daily_bull=daily_bull,
            daily_bear=daily_bear,
        )

        results.append({
            "timestamp": df.index[i],
            "signal": result.signal,
            "label": result.label,
            "sl": result.sl,
            "tp": result.tp,
            "rr": result.rr,
            "atr": result.atr,
            "entry_price": result.entry_price,
            "stage": result.stage,
            "score": result.score,
            "reason": result.reason,
            "position_size_mult": result.position_size_multiplier,
            "confirmation_tags": "|".join(result.confirmation_tags),
            "rsi": round(df["rsi"].iloc[i], 4),
            "ema100": round(df["ema100"].iloc[i], 6),
            "adx": round(adx_df["adx"].iloc[i], 2),
            "bull_score": cr.bull_score(),
            "bear_score": cr.bear_score(),
        })

    return pd.DataFrame(results).set_index("timestamp") if results else pd.DataFrame()


def _null_row(ts) -> dict:
    return {
        "timestamp": ts,
        "signal": 0,
        "label": "NEUTRAL",
        "sl": math.nan,
        "tp": math.nan,
        "rr": math.nan,
        "atr": math.nan,
        "entry_price": math.nan,
        "stage": "WARMING UP",
        "score": 0,
        "reason": "Warming up indicators",
        "position_size_mult": 1.0,
        "confirmation_tags": "",
        "rsi": math.nan,
        "ema100": math.nan,
        "adx": math.nan,
        "bull_score": 0,
        "bear_score": 0,
    }


