@dataclass
class ConfluenceResult:
    bos_bull:             bool = False
    bos_bear:             bool = False
    htf_bias_bull:        bool = False
    htf_bias_bear:        bool = False
    daily_bias_bull:      bool = False
    daily_bias_bear:      bool = False
    compression:          bool = False
    atr_expansion:        bool = False
    hidden_bull_div:      bool = False
    hidden_bear_div:      bool = False
    adx_ok:               bool = False
    body_bull:            bool = False
    body_bear:            bool = False
    in_session:           bool = False

    def bull_score(self) -> int:
        return sum([
            self.bos_bull,
            self.htf_bias_bull,
            self.daily_bias_bull,
            self.compression,
            self.atr_expansion,
            self.hidden_bull_div,
            self.adx_ok,
            self.body_bull,
        ])

    def bear_score(self) -> int:
        return sum([
            self.bos_bear,
            self.htf_bias_bear,
            self.daily_bias_bear,
            self.compression,
            self.atr_expansion,
            self.hidden_bear_div,
            self.adx_ok,
            self.body_bear,
        ])

    def bull_tags(self) -> list[str]:
        tags = []
        if self.bos_bull:          tags.append("BOS_BULL")
        if self.htf_bias_bull:     tags.append("HTF_BULL")
        if self.daily_bias_bull:   tags.append("DAILY_BULL")
        if self.compression:       tags.append("COMPRESSION")
        if self.atr_expansion:     tags.append("EXPANSION")
        if self.hidden_bull_div:   tags.append("HIDDEN_BULL_DIV")
        if self.adx_ok:            tags.append("ADX_OK")
        if self.body_bull:         tags.append("BODY_BULL")
        return tags

    def bear_tags(self) -> list[str]:
        tags = []
        if self.bos_bear:          tags.append("BOS_BEAR")
        if self.htf_bias_bear:     tags.append("HTF_BEAR")
        if self.daily_bias_bear:   tags.append("DAILY_BEAR")
        if self.compression:       tags.append("COMPRESSION")
        if self.atr_expansion:     tags.append("EXPANSION")
        if self.hidden_bear_div:   tags.append("HIDDEN_BEAR_DIV")
        if self.adx_ok:            tags.append("ADX_OK")
        if self.body_bear:         tags.append("BODY_BEAR")
        return tags


def _evaluate_confluence(
    df: pd.DataFrame,
    bar_idx: int,
    state: StructureState,
    adx_df: pd.DataFrame,
    cfg: V3Config,
    htf_bull: bool,
    htf_bear: bool,
    daily_bull: bool,
    daily_bear: bool,
) -> ConfluenceResult:
    cr = ConfluenceResult()
    row = df.iloc[bar_idx]
    atr_now = row.get("atr", math.nan)

    if math.isnan(atr_now) or atr_now == 0.0:
        return cr

    close = row["close"]
    open_ = row["open"]
    high = row["high"]
    low = row["low"]

    # BOS
    if state.has_swing_high and not math.isnan(atr_now):
        cr.bos_bull = close > (state.last_swing_high + cfg.bos_atr_buffer * atr_now)
    if state.has_swing_low and not math.isnan(atr_now):
        cr.bos_bear = close < (state.last_swing_low - cfg.bos_atr_buffer * atr_now)

    # HTF / Daily bias
    cr.htf_bias_bull = htf_bull
    cr.htf_bias_bear = htf_bear
    cr.daily_bias_bull = daily_bull
    cr.daily_bias_bear = daily_bear

    # ATR Compression — FIXED: stationary 20-bar baseline
    if "atr" in df.columns and bar_idx >= 25:
        recent_atr = df["atr"].iloc[bar_idx - cfg.compression_lookback: bar_idx].mean()
        baseline_atr = df["atr"].iloc[bar_idx - 20: bar_idx].mean()
        if baseline_atr > 0:
            ratio = recent_atr / baseline_atr
            cr.compression = ratio < cfg.compression_ratio

    # ATR Expansion
    if "atr" in df.columns and bar_idx > 0:
        prev_atr = df["atr"].iloc[bar_idx - 1]
        cr.atr_expansion = (atr_now > prev_atr) if not math.isnan(prev_atr) else False

    # Hidden Divergence
    if state.has_divergence_data and "rsi" in df.columns:
        if (not math.isnan(state.last_swing_low_rsi) and not math.isnan(state.prev_swing_low_rsi)):
            price_higher_low = state.last_swing_low > state.prev_swing_low
            rsi_lower_low = state.last_swing_low_rsi < state.prev_swing_low_rsi
            cr.hidden_bull_div = price_higher_low and rsi_lower_low
        if (not math.isnan(state.last_swing_high_rsi) and not math.isnan(state.prev_swing_high_rsi)):
            price_lower_high = state.last_swing_high < state.prev_swing_high
            rsi_higher_high = state.last_swing_high_rsi > state.prev_swing_high_rsi
            cr.hidden_bear_div = price_lower_high and rsi_higher_high

    # ADX Momentum
    if len(adx_df) > bar_idx and bar_idx > 0:
        adx_now = adx_df["adx"].iloc[bar_idx]
        adx_prev = adx_df["adx"].iloc[bar_idx - 1]
        adx_slope = adx_now - adx_prev
        cr.adx_ok = (adx_now > cfg.adx_min_level) and (adx_slope > cfg.adx_min_slope)

    # Entry Candle Body
    body = abs(close - open_)
    range_ = high - low
    if range_ > 0:
        body_ratio = body / range_
        ema_val = df["ema100"].iloc[bar_idx] if "ema100" in df.columns else math.nan
        if not math.isnan(ema_val):
            cr.body_bull = (close > open_) and (close > ema_val) and (body_ratio >= cfg.body_ratio_min)
            cr.body_bear = (close < open_) and (close < ema_val) and (body_ratio >= cfg.body_ratio_min)
        else:
            cr.body_bull = (close > open_) and (body_ratio >= cfg.body_ratio_min)
            cr.body_bear = (close < open_) and (body_ratio >= cfg.body_ratio_min)

    # Session filter
    if df.index.tz is None:
        bar_hour = df.index[bar_idx].hour
    else:
        bar_hour = df.index[bar_idx].tz_convert("UTC").hour
    cr.in_session = cfg.session_start_utc <= bar_hour <= cfg.session_end_utc

    return cr


