# SIGNAL ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

class SilentStructureEngine:
    MIN_BARS = 200

    def __init__(
        self,
        ticker: str,
        interval: str,
        config: Optional[V3Config] = None,
    ):
        self.ticker = ticker
        self.interval = interval
        self.cfg = config or get_v3_config(interval)
        self.state = StructureState()
        self._last_result: Optional[SignalResult] = None

    def evaluate(self, df_ohlcv: pd.DataFrame) -> SignalResult:
        neutral = SignalResult(stage=self.stage, reason="Insufficient data")

        if df_ohlcv is None or len(df_ohlcv) < self.MIN_BARS:
            return neutral

        required = {"open", "high", "low", "close"}
        if not required.issubset(df_ohlcv.columns):
            return neutral

        df = df_ohlcv.copy()
        if df.index.tz is None:
            df.index = df.index.tz_localize("UTC")
        elif str(df.index.tz) != "UTC":
            df.index = df.index.tz_convert("UTC")

        df["rsi"] = _rsi(df["close"], self.cfg.rsi_period)
        df["ema100"] = _ema(df["close"], self.cfg.htf_ema_period)
        df["atr"] = _atr(df, self.cfg.atr_period)
        adx_df = _adx(df, self.cfg.adx_period)

        ph_series = _pivot_highs(df["high"], self.cfg.pivot_lookback)
        pl_series = _pivot_lows(df["low"], self.cfg.pivot_lookback)

        htf_bull, htf_bear = _get_htf_bias(df, self.cfg.htf_resample, self.cfg.htf_ema_period, interval=self.interval)
        daily_bull, daily_bear = _get_daily_bias(df, self.cfg.htf_ema_period)

        bar_idx = len(df) - 1

        result = self._process_bar(
            df=df,
            bar_idx=bar_idx,
            ph_series=ph_series,
            pl_series=pl_series,
            adx_df=adx_df,
            htf_bull=htf_bull,
            htf_bear=htf_bear,
            daily_bull=daily_bull,
            daily_bear=daily_bear,
        )

        self._last_result = result
        return result

    def advance_state(
        self,
        df_ohlcv: pd.DataFrame,
        persisted_state: Optional[dict] = None,
        last_processed_bar_time: Optional[str] = None,
    ) -> tuple[SignalResult, dict]:
        neutral_state = persisted_state or {}
        neutral = SignalResult(stage=self.stage, reason="Insufficient data")

        if df_ohlcv is None or len(df_ohlcv) < self.MIN_BARS:
            return neutral, neutral_state

        if persisted_state:
            self.state = StructureState.from_dict(persisted_state)

        df = df_ohlcv.copy()
        if df.index.tz is None:
            df.index = df.index.tz_localize("UTC")
        elif str(df.index.tz) != "UTC":
            df.index = df.index.tz_convert("UTC")

        df["rsi"] = _rsi(df["close"], self.cfg.rsi_period)
        df["ema100"] = _ema(df["close"], self.cfg.htf_ema_period)
        df["atr"] = _atr(df, self.cfg.atr_period)
        adx_df = _adx(df, self.cfg.adx_period)

        ph_series = _pivot_highs(df["high"], self.cfg.pivot_lookback)
        pl_series = _pivot_lows(df["low"], self.cfg.pivot_lookback)

        htf_bull, htf_bear = _get_htf_bias(df, self.cfg.htf_resample, self.cfg.htf_ema_period, interval=self.interval)
        daily_bull, daily_bear = _get_daily_bias(df, self.cfg.htf_ema_period)

        start_idx = 0
        if last_processed_bar_time:
            try:
                last_ts = pd.Timestamp(last_processed_bar_time, tz="UTC")
                mask = df.index > last_ts
                start_idx = df.index.get_loc(df.index[mask][0]) if mask.any() else len(df)
            except Exception as e:
                logger.warning(f"[V3_ADVANCE] {self.ticker}-{self.interval}: {e}")

        last_result = SignalResult(stage=self.stage, reason="No new bars")

        for i in range(start_idx, len(df)):
            result = self._process_bar(
                df=df,
                bar_idx=i,
                ph_series=ph_series,
                pl_series=pl_series,
                adx_df=adx_df,
                htf_bull=htf_bull,
                htf_bear=htf_bear,
                daily_bull=daily_bull,
                daily_bear=daily_bear,
            )
            if result.signal != Signal.NEUTRAL:
                last_result = result

        updated_state = self.state.to_dict()
        updated_state["last_processed_bar_time"] = df.index[-1].isoformat()

        return last_result, updated_state

    def restore_state(self, state_dict: dict):
        self.state = StructureState.from_dict(state_dict)

    def reset(self):
        self.state = StructureState()
        self._last_result = None

    @property
    def stage(self) -> str:
        bias = self.state.trend_bias.upper()
        if self.state.in_position:
            return f"IN POSITION ({bias})"
        if not math.isnan(self.state.bos_level):
            return f"BOS ACTIVE ({bias}) — WATCHING ENTRY"
        return "SCANNING"

    @property
    def last_result(self) -> Optional[SignalResult]:
        return self._last_result

    def _process_bar(
        self,
        df: pd.DataFrame,
        bar_idx: int,
        ph_series: pd.Series,
        pl_series: pd.Series,
        adx_df: pd.DataFrame,
        htf_bull: bool,
        htf_bear: bool,
        daily_bull: bool,
        daily_bear: bool,
    ) -> SignalResult:
        s = self.state
        cfg = self.cfg
        row = df.iloc[bar_idx]

        atr_now = row.get("atr", math.nan)
        rsi_now = df["rsi"].iloc[bar_idx] if "rsi" in df.columns else math.nan

        # Auto-reset in_position
        if s.in_position and (bar_idx - s.position_bar) > cfg.in_position_reset_bars:
            s.in_position = False

        # Update swing structure
        self._update_structure(bar_idx, ph_series, pl_series, df, rsi_now)

        # Evaluate confluence
        cr = _evaluate_confluence(
            df=df,
            bar_idx=bar_idx,
            state=s,
            adx_df=adx_df,
            cfg=cfg,
            htf_bull=htf_bull,
            htf_bear=htf_bear,
            daily_bull=daily_bull,
            daily_bear=daily_bear,
        )

        # Session filter
        if self.cfg.session_filter_enabled and not cr.in_session:
            return SignalResult(stage=self.stage, reason="Outside session")

        # Cooldown
        if s.in_position or (bar_idx - s.last_signal_bar) < cfg.min_bars_between_signals:
            return SignalResult(stage=self.stage, reason="Cooldown active")

        bull_score = cr.bull_score()
        bear_score = cr.bear_score()

        # LONG
        if cr.bos_bull and cr.body_bull and bull_score >= cfg.min_score:
            sl, tp, rr = self._compute_risk(df, bar_idx, atr_now, "bull")
            if math.isnan(sl) or math.isnan(tp):
                return SignalResult(stage=self.stage, reason="BUY: Invalid SL/TP")

            pos_mult = 1.0 if bull_score >= cfg.min_score + 1 else 0.75
            s.bos_level = row["high"]
            s.trend_bias = "bull"
            s.last_signal_bar = bar_idx
            s.in_position = True
            s.position_bar = bar_idx

            return SignalResult(
                signal=int(Signal.BUY),
                sl=sl,
                tp=tp,
                rr=rr,
                atr=atr_now,
                entry_price=row["close"],
                stage=self.stage,
                score=bull_score,
                reason=f"BUY: score={bull_score}/{cfg.min_score + 1} tags={cr.bull_tags()}",
                position_size_multiplier=pos_mult,
                confirmation_tags=cr.bull_tags(),
            )

        # SHORT
        if cr.bos_bear and cr.body_bear and bear_score >= cfg.min_score:
            sl, tp, rr = self._compute_risk(df, bar_idx, atr_now, "bear")
            if math.isnan(sl) or math.isnan(tp):
                return SignalResult(stage=self.stage, reason="SELL: Invalid SL/TP")

            pos_mult = 1.0 if bear_score >= cfg.min_score + 1 else 0.75
            s.bos_level = row["low"]
            s.trend_bias = "bear"
            s.last_signal_bar = bar_idx
            s.in_position = True
            s.position_bar = bar_idx

            return SignalResult(
                signal=int(Signal.SELL),
                sl=sl,
                tp=tp,
                rr=rr,
                atr=atr_now,
                entry_price=row["close"],
                stage=self.stage,
                score=bear_score,
                reason=f"SELL: score={bear_score}/{cfg.min_score + 1} tags={cr.bear_tags()}",
                position_size_multiplier=pos_mult,
                confirmation_tags=cr.bear_tags(),
            )

        return SignalResult(
            stage=self.stage,
            reason=f"No signal: bull_score={bull_score} bear_score={bear_score} (need {cfg.min_score})",
            score=max(bull_score, bear_score),
        )

    def _update_structure(
        self,
        bar_idx: int,
        ph_series: pd.Series,
        pl_series: pd.Series,
        df: pd.DataFrame,
        rsi_now: float,
    ):
        s = self.state
        cfg = self.cfg

        ph_val = ph_series.iloc[bar_idx]
        if not pd.isna(ph_val):
            if (bar_idx - s.last_pivot_bar) >= cfg.min_pivot_spacing:
                s.prev_swing_high = s.last_swing_high
                s.prev_swing_high_rsi = s.last_swing_high_rsi
                s.last_swing_high = ph_val
                s.last_swing_high_rsi = rsi_now
                s.last_pivot_bar = bar_idx

        pl_val = pl_series.iloc[bar_idx]
        if not pd.isna(pl_val):
            if (bar_idx - s.last_pivot_bar) >= cfg.min_pivot_spacing:
                s.prev_swing_low = s.last_swing_low
                s.prev_swing_low_rsi = s.last_swing_low_rsi
                s.last_swing_low = pl_val
                s.last_swing_low_rsi = rsi_now
                s.last_pivot_bar = bar_idx

    def _compute_risk(
        self,
        df: pd.DataFrame,
        bar_idx: int,
        atr_now: float,
        direction: str,
    ) -> tuple[float, float, float]:
        s = self.state
        cfg = self.cfg
        row = df.iloc[bar_idx]
        close = row["close"]

        try:
            if direction == "bull":
                anchor = s.last_swing_low if s.has_swing_low else (close - 2.0 * atr_now)
                sl = anchor - (cfg.sl_atr_multiplier * atr_now)
                risk = close - sl
                if risk <= 0:
                    return math.nan, math.nan, math.nan
                tp = close + (risk * cfg.rr_ratio)
                rr = cfg.rr_ratio
            elif direction == "bear":
                anchor = s.last_swing_high if s.has_swing_high else (close + 2.0 * atr_now)
                sl = anchor + (cfg.sl_atr_multiplier * atr_now)
                risk = sl - close
                if risk <= 0:
                    return math.nan, math.nan, math.nan
                tp = close - (risk * cfg.rr_ratio)
                rr = cfg.rr_ratio
            else:
                return math.nan, math.nan, math.nan

            return round(sl, 6), round(tp, 6), round(rr, 2)

        except Exception as e:
            logger.warning(f"[V3_RISK] {self.ticker}-{self.interval}: {e}")
            return math.nan, math.nan, math.nan


