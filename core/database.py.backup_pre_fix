    def load_features(self, ticker: str = None, interval: str = None, days: int = 90) -> Optional[pd.DataFrame]:
        """
        Load features from features table
        
        Args:
            ticker: Trading symbol (optional)
            interval: Timeframe (optional)
            days: Number of days to load
            
        Returns:
            DataFrame with features
        """
        try:
            conn = sqlite3.connect(self.db_path)
            
            cutoff_date = (datetime.now() - pd.Timedelta(days=days)).strftime('%Y-%m-%d')
            
            # Check if lag1 columns exist in the features table
            # These were added in migration 004_add_lag1_features.py
            # If migration hasn't run, fall back to base features only
            lag1_cols = []
            try:
                # Try to check for lag1 columns
                check_query = "PRAGMA table_info(features)"
                cols_info = pd.read_sql_query(check_query, conn)
                existing_col_names = cols_info['name'].tolist() if 'name' in cols_info.columns else []
                
                lag1_candidates = [
                    'ema_21_lag1', 'ema_100_lag1', 'rsi_14_lag1',
                    'obv_lag1', 'ad_lag1', 'vwap_slope_lag1',
                    'volume_sma_20_lag1', 'volume_ratio_lag1'
                ]
                lag1_cols = [col for col in lag1_candidates if col in existing_col_names]
            except Exception as e:
                logging.warning(f"Could not check for lag1 columns: {e}")
                lag1_cols = []
            
            # Build feature columns list
            feature_cols = [
                'timestamp', 'ticker', 'interval',
                'open', 'high', 'low', 'close', 'volume',
                'ema_21', 'ema_100', 'rsi_14',
                'obv', 'ad', 'vwap', 'vwap_slope',
                'volume_sma_20', 'volume_ratio',
            ]
            
            # Add lag1 columns if they exist
            if lag1_cols:
                feature_cols.extend(lag1_cols)
                logging.debug(f"Loading {len(lag1_cols)} lag1 columns from database")
            else:
                logging.debug("Lag1 columns not available in database - will be created during inference")
            
            cols_str = ', '.join(feature_cols)
            
            if ticker and interval:
                query = f'''
                SELECT {cols_str} FROM features 
                WHERE ticker = ? AND interval = ? AND timestamp >= ?
                ORDER BY timestamp ASC
                '''
                params = (ticker, interval, cutoff_date)
            elif ticker:
                query = f'''
                SELECT {cols_str} FROM features 
                WHERE ticker = ? AND timestamp >= ?
                ORDER BY timestamp ASC
                '''
                params = (ticker, cutoff_date)
            else:
                query = f'''
                SELECT {cols_str} FROM features 
                WHERE timestamp >= ?
                ORDER BY timestamp ASC
                '''
                params = (cutoff_date,)
            
            df = pd.read_sql_query(query, conn, params=params)
            conn.close()
            
            if df.empty:
                return None
            
            df['timestamp'] = pd.to_datetime(df['timestamp'])
            
            return df
            
        except Exception as e:
            print(f"❌ Error loading features: {e}")
            return None
    
    def has_recent_signal(self, ticker: str, interval: str, signal: int, minutes: int = 30) -> bool:
        """
        Check if a recent signal with the same ticker/interval/direction exists.
        Used to prevent duplicate signal generation from persistent market conditions.
        
        Args:
            ticker: Trading symbol
            interval: Timeframe
            signal: Signal direction (1=BUY, -1=SELL)
            minutes: Lookback window in minutes (default: 30)
            
        Returns:
            True if a recent signal exists, False otherwise
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            # Get current time and cutoff (now - minutes)
            now_timestamp = datetime.now(timezone.utc).isoformat()
            cutoff_time = (datetime.now(timezone.utc) - timedelta(minutes=minutes)).isoformat()
            
            cursor.execute(
                '''
                SELECT COUNT(*) FROM ml_signals 
                WHERE ticker = ? AND interval = ? AND signal = ? AND timestamp > ?
                LIMIT 1
                ''',
                (ticker, interval, signal, cutoff_time)
            )
            
            count = cursor.fetchone()[0]
            conn.close()
            
            return count > 0
        except Exception as e:
            print(f"⚠️  Error checking for recent signals: {e}")
            return False
    
    def has_recent_signal_with_price(
        self, 
        ticker: str, 
        interval: str, 
        signal: int,
        entry_price: float,
        price_tolerance: float,
        minutes: int = 60
    ) -> bool:
        """
        Check if an identical signal exists (same ticker/interval/direction and entry price).
        Allows new breakouts at different prices while blocking exact duplicates.
        
        Args:
            ticker: Trading symbol
            interval: Timeframe
            signal: Signal direction (1=BUY, -1=SELL)
            entry_price: Entry price from new signal
            price_tolerance: Max price difference to consider as duplicate
            minutes: Lookback window in minutes (default: 60)
            
        Returns:
            True if an identical signal exists within tolerance, False otherwise
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cutoff_time = (datetime.now(timezone.utc) - timedelta(minutes=minutes)).isoformat()
            
            # Check for signals with same ticker/interval/direction and entry price within tolerance
            cursor.execute(
                '''
                SELECT COUNT(*) FROM ml_signals 
                WHERE ticker = ? 
                AND interval = ? 
                AND signal = ? 
                AND timestamp > ?
                AND entry_price IS NOT NULL
                AND entry_price >= ? AND entry_price <= ?
                LIMIT 1
                ''',
                (ticker, interval, signal, cutoff_time, 
                 entry_price - price_tolerance, entry_price + price_tolerance)
            )
            
            count = cursor.fetchone()[0]
            conn.close()
            
            return count > 0
        except Exception as e:
            print(f"⚠️  Error checking for signal with price: {e}")
            return False
    
