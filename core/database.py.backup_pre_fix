    def load_raw_ohlcv(self, ticker: str, interval: str, days: int = 90) -> Optional[pd.DataFrame]:
        """
        Load raw OHLCV data from ohlcv_data table
        
        Args:
            ticker: Trading symbol
            interval: Timeframe
            days: Number of days to load
            
        Returns:
            DataFrame with raw OHLCV data
        """
        try:
            conn = sqlite3.connect(self.db_path)
            
            cutoff_date = (datetime.now() - pd.Timedelta(days=days)).strftime('%Y-%m-%d')
            
            query = '''
            SELECT timestamp, open, high, low, close, volume 
            FROM ohlcv_data 
            WHERE symbol = ? AND timeframe = ? AND timestamp >= ?
            ORDER BY timestamp ASC
            '''
            
            df = pd.read_sql_query(query, conn, params=(ticker, interval, cutoff_date))
            conn.close()
            
            if df.empty:
                return None
            
            df['timestamp'] = pd.to_datetime(df['timestamp'])
            df = df.set_index('timestamp')
            
            return df
            
        except Exception as e:
            print(f"❌ Error loading raw OHLCV: {e}")
            return None
    
