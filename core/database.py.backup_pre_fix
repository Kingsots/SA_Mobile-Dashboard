    def load_strategy_state(
        self,
        ticker: str,
        interval: str,
        strategy_name: str = 'strategy_core_v2'
    ) -> Optional[Dict]:
        """
        Load V2 SequenceState from database.
        
        Returns complete state dict for SequenceState reconstruction:
        {
            'bull_extreme_visited': bool,
            'bear_extreme_visited': bool,
            'extreme_bar': int,
            'bull_break_bar': int | None,
            'bear_break_bar': int | None,
            'bull_retest_done': bool,
            'bear_retest_done': bool,
            'bull_retest_bar': int | None,
            'bear_retest_bar': int | None,
            'bull_entry_armed': bool,
            'bear_entry_armed': bool,
            'bull_entry_window_bar': int | None,
            'bear_entry_window_bar': int | None,
            'last_processed_bar_time': str | None,
        }
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
                SELECT 
                    bull_extreme_visited, bear_extreme_visited, extreme_bar,
                    bull_break_bar, bear_break_bar,
                    bull_retest_done, bear_retest_done, bull_retest_bar, bear_retest_bar,
                    bull_entry_armed, bear_entry_armed, bull_entry_window_bar, bear_entry_window_bar,
                    last_processed_bar_time
                FROM strategy_state 
                WHERE ticker = ? AND interval = ? AND strategy_name = ?
            ''', (ticker, interval, strategy_name))
            
            row = cursor.fetchone()
            conn.close()
            
            if row:
                return {
                    'bull_extreme_visited': bool(row[0]),
                    'bear_extreme_visited': bool(row[1]),
                    'extreme_bar': row[2] or 0,
                    'bull_break_bar': row[3],
                    'bear_break_bar': row[4],
                    'bull_retest_done': bool(row[5]),
                    'bear_retest_done': bool(row[6]),
                    'bull_retest_bar': row[7],
                    'bear_retest_bar': row[8],
                    'bull_entry_armed': bool(row[9]),
                    'bear_entry_armed': bool(row[10]),
                    'bull_entry_window_bar': row[11],
                    'bear_entry_window_bar': row[12],
                    'last_processed_bar_time': row[13],
                }
            return None
            
        except Exception as e:
            logging.warning(f"Error loading strategy state for {ticker}-{interval}: {e}")
            return None
    
    def save_strategy_state(
        self,
        ticker: str,
        interval: str,
        strategy_name: str,
        state: Dict
    ) -> bool:
        """
        Save V2 SequenceState to database.
        
        Args:
            state: Dict with keys from SequenceState dataclass
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
                INSERT OR REPLACE INTO strategy_state
                (ticker, interval, strategy_name,
                 bull_extreme_visited, bear_extreme_visited, extreme_bar,
                 bull_break_bar, bear_break_bar,
                 bull_retest_done, bear_retest_done, bull_retest_bar, bear_retest_bar,
                 bull_entry_armed, bear_entry_armed, bull_entry_window_bar, bear_entry_window_bar,
                 last_processed_bar_time, last_updated)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                ticker,
                interval,
                strategy_name,
                1 if state.get('bull_extreme_visited', False) else 0,
                1 if state.get('bear_extreme_visited', False) else 0,
                state.get('extreme_bar', 0),
                state.get('bull_break_bar'),
                state.get('bear_break_bar'),
                1 if state.get('bull_retest_done', False) else 0,
                1 if state.get('bear_retest_done', False) else 0,
                state.get('bull_retest_bar'),
                state.get('bear_retest_bar'),
                1 if state.get('bull_entry_armed', False) else 0,
                1 if state.get('bear_entry_armed', False) else 0,
                state.get('bull_entry_window_bar'),
                state.get('bear_entry_window_bar'),
                state.get('last_processed_bar_time'),
                datetime.now(timezone.utc).isoformat()
            ))
            
            conn.commit()
            conn.close()
            return True
            
        except Exception as e:
            logging.error(f"Error saving strategy state for {ticker}-{interval}: {e}")
            return False
    
    def clear_strategy_state(
        self,
        ticker: str,
        interval: str,
        strategy_name: str = 'strategy_core_v2'
    ) -> bool:
        """
        Clear strategy state (reset to initial).
        
        Args:
            ticker: Trading symbol
            interval: Timeframe
            strategy_name: Strategy identifier
            
        Returns:
            True if successful
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
                DELETE FROM strategy_state 
                WHERE ticker = ? AND interval = ? AND strategy_name = ?
            ''', (ticker, interval, strategy_name))
            
            conn.commit()
            conn.close()
            
            logging.info(f"Cleared state for {ticker}-{interval}")
            return True
            
        except Exception as e:
            logging.error(f"Error clearing strategy state: {e}")
            return False

    def bootstrap_strategy_state(self) -> bool:
        """
        Ensure all (ticker, interval, strategy_name) rows exist in strategy_state.
        
        Called on startup to establish all planned state records before processing begins.
        Uses ENTRY_TIMEFRAMES from config.
        
        Returns:
            True if all rows created/verified successfully
        """
        try:
            from .config import Config
            
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            symbols = Config.get_symbol_list()
            intervals = Config.ENTRY_TIMEFRAMES
            strategy_name = 'strategy_core_v2'
            
            total_rows = 0
            for symbol in symbols:
                for interval in intervals:
                    # INSERT OR IGNORE - if row exists, do nothing. If doesn't exist, create default state.
                    cursor.execute('''
                        INSERT OR IGNORE INTO strategy_state
                        (ticker, interval, strategy_name,
                         bull_extreme_visited, bear_extreme_visited, extreme_bar,
                         bull_break_bar, bear_break_bar,
                         bull_retest_done, bear_retest_done, bull_retest_bar, bear_retest_bar,
                         bull_entry_armed, bear_entry_armed, bull_entry_window_bar, bear_entry_window_bar,
                         last_processed_bar_time, last_updated)
                        VALUES (?, ?, ?, 0, 0, 0, NULL, NULL, 0, 0, NULL, NULL, 0, 0, NULL, NULL, NULL, ?)
                    ''', (symbol, interval, strategy_name, datetime.now(timezone.utc).isoformat()))
                    total_rows += 1
            
            # Verify total count
            cursor.execute('SELECT COUNT(*) FROM strategy_state')
            final_count = cursor.fetchone()[0]
            
            conn.commit()
            conn.close()
            
            expected_count = len(symbols) * len(intervals)
            logging.info(
                f"✅ Strategy state bootstrap complete:\n"
                f"   Symbols: {len(symbols)}\n"
                f"   Intervals: {len(intervals)} {intervals}\n"
                f"   Expected rows: {expected_count}\n"
                f"   Actual rows: {final_count}"
            )
            
            return final_count >= expected_count
            
        except Exception as e:
            logging.error(f"Error bootstrapping strategy state: {e}")
            return False

