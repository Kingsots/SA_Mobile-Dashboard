                ticker=trade_data.get('ticker'),
                timestamp=trade_data.get('timestamp'),
                interval=trade_data.get('interval'),
                signal=trade_data.get('signal', 0),
                confidence=trade_data.get('confidence', 1.0),
                feature_snapshot=trade_data.get('feature_snapshot', '{}'),
                model_version=trade_data.get('model_version', 'strategy_core_v2'),
                triggered_by=trade_data.get('triggered_by', 'v2_persistence'),
                trade_id=trade_data.get('trade_id'),
                entry_price=trade_data.get('entry_price'),
                stop_loss=trade_data.get('stop_loss'),
                take_profit=trade_data.get('take_profit'),
                risk_reward=trade_data.get('risk_reward'),
                entry_type=trade_data.get('entry_type'),
                signal_candle_time=trade_data.get('signal_candle_time'),
                expiry_timestamp=trade_data.get('expiry_timestamp'),
                expiry_candles=trade_data.get('expiry_candles'),
            )
        except Exception as e:
            logging.error(f"Error saving trade: {e}")
            return False

    def is_signal_broadcasted(self, signal_id: int) -> bool:
        """Check if signal already broadcasted to Telegram."""
        try:
            with self.conn:
                cursor = self.conn.execute(
                    "SELECT broadcasted FROM ml_signals WHERE id = ?",
                    (signal_id,)
                )
                result = cursor.fetchone()
                return bool(result[0]) if result else False
        except Exception as e:
            logging.error(f"Error checking broadcasted: {e}")
            return False

    def mark_signal_broadcasted(self, signal_id: int) -> bool:
        """
        Mark a signal as successfully broadcast to Telegram
        
        Args:
            signal_id: ID of the ml_signals row to mark as broadcasted
            
        Returns:
            True if successful, False otherwise
        """
        try:
            with self.conn:
                self.conn.execute(
                    "UPDATE ml_signals SET broadcasted = 1 WHERE id = ?",
                    (signal_id,)
                )
            return True
        except Exception as e:
            logging.error(f"Failed to mark signal broadcasted: {e}")
            return False

    def get_processed_events_count(self) -> int:
        """
        Get count of currently valid (non-expired) processed events
        
        Returns:
            Number of events still in the 24-hour window
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            now = datetime.now().isoformat()
            
            cursor.execute('''
            SELECT COUNT(*) FROM processed_events 
            WHERE expires_at > ?
            ''', (now,))
            
            result = cursor.fetchone()
            return result[0] if result else 0
        except Exception as e:
            print(f"❌ Error getting processed events count: {e}")
            return 0
        finally:
            conn.close()

    def log_context(self, ticker: str, interval: str, timestamp: str, context_state: Dict) -> bool:
        """
        Log context engine state to database for observation phase
        
        Called once per bar after context_engine.compute_context()
        Logs even if context doesn't trigger signals (observation phase)
        
        Args:
            ticker: Trading symbol
            interval: Timeframe
            timestamp: ISO datetime string
            context_state: Dict from context_engine.compute_context() with 7 fields
        
        Returns:
            True if logged successfully, False otherwise
        """
        try:
            conn = sqlite3.connect(self.db_path)
            cursor = conn.cursor()
            
            cursor.execute('''
            INSERT INTO context_log 
            (ticker, interval, timestamp, compression_score, expansion_pressure, 
             rsi_stage, nearest_liquidity, liquidity_type, distance_to_liquidity, liquidity_sweep)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                ticker,
                interval,
                timestamp,
                context_state.get('compression_score', 0.0),
                context_state.get('expansion_pressure', 0.0),
                context_state.get('rsi_stage', 'NEUTRAL'),
                context_state.get('nearest_liquidity', 0.0),
                context_state.get('liquidity_type', 'none'),
                context_state.get('distance_to_liquidity', 0.0),
                1 if context_state.get('liquidity_sweep', False) else 0
            ))
            
            conn.commit()
            return True
            
        except Exception as e:
            logging.error(f"[CONTEXT] Failed to log context for {ticker}-{interval}: {e}")
            return False
        finally:
            conn.close()

