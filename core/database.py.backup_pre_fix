    @staticmethod
    def _column_exists(cursor: sqlite3.Cursor, table: str, column: str) -> bool:
        cursor.execute(f"PRAGMA table_info({table})")
        return any(row[1] == column for row in cursor.fetchall())

    def _ensure_triggered_by(self, cursor: sqlite3.Cursor) -> None:
        """Ensure ml_signals table contains triggered_by column."""
        if not self._column_exists(cursor, 'ml_signals', 'triggered_by'):
            cursor.execute("ALTER TABLE ml_signals ADD COLUMN triggered_by TEXT DEFAULT 'time'")

    def _ensure_trade_construction_columns(self, cursor: sqlite3.Cursor) -> None:
        """Ensure ml_signals table contains all trade construction columns."""
        trade_columns = {
            'trade_id': 'TEXT',
            'entry_price': 'REAL',
            'stop_loss': 'REAL',
            'take_profit': 'REAL',
            'risk_reward': 'REAL',
            'entry_type': 'TEXT',
            'signal_candle_time': 'INTEGER',
            'expiry_timestamp': 'INTEGER',
            'expiry_candles': 'INTEGER',
        }
        
        for col_name, col_type in trade_columns.items():
            if not self._column_exists(cursor, 'ml_signals', col_name):
                try:
                    cursor.execute(f"ALTER TABLE ml_signals ADD COLUMN {col_name} {col_type}")
                except sqlite3.OperationalError:
                    pass  # Column may already exist

    def _run_migrations(self) -> None:
        """Execute registered migrations against the configured database."""
        for module_path, function_name in self.MIGRATIONS:
            module = importlib.import_module(module_path)
            migration = getattr(module, function_name, None)
            if migration is None:
                continue
            try:
                migration(self.db_path)
            except TypeError:
                migration()

    def run_migrations(self) -> None:
        """Public wrapper to execute all migrations."""
        self._run_migrations()

    @staticmethod
    def _parse_timestamp(value: Optional[str]) -> Optional[datetime]:
        if not value:
            return None
        try:
            return datetime.fromisoformat(value)
        except Exception:
            return None

    def _get_latest_timestamp(self, table: str, ticker: str, interval: str) -> Optional[datetime]:
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            # Handle different column names for different tables
            if table == 'ohlcv_data':
                cursor.execute(
                    f"""
                    SELECT timestamp
                    FROM {table}
                    WHERE symbol = ? AND timeframe = ?
                    ORDER BY timestamp DESC
                    LIMIT 1
                    """,
                    (ticker, interval),
                )
            else:
                cursor.execute(
                    f"""
                    SELECT timestamp
                    FROM {table}
                    WHERE ticker = ? AND interval = ?
                    ORDER BY timestamp DESC
                    LIMIT 1
                    """,
                    (ticker, interval),
                )
            row = cursor.fetchone()
            return self._parse_timestamp(row[0]) if row else None
        finally:
            conn.close()

    def get_latest_raw_timestamp(self, ticker: str, interval: str) -> Optional[datetime]:
        return self._get_latest_timestamp('ohlcv_data', ticker, interval)

    def get_latest_feature_timestamp(self, ticker: str, interval: str) -> Optional[datetime]:
        return self._get_latest_timestamp('features', ticker, interval)

    def get_symbol_freshness(
        self,
        interval: str,
        symbols: Optional[List[str]] = None,
    ) -> List[Dict[str, Optional[float]]]:
        """Return raw vs feature freshness metrics per symbol."""
        if symbols is None:
            symbols = Config.get_symbol_list()

        now = datetime.now(timezone.utc)
        freshness: List[Dict[str, Optional[float]]] = []

        for symbol in symbols:
            raw_ts = self.get_latest_raw_timestamp(symbol, interval)
            feature_ts = self.get_latest_feature_timestamp(symbol, interval)

            def age_minutes(ts: Optional[datetime]) -> Optional[float]:
                if ts is None:
                    return None
                return (now - ts).total_seconds() / 60.0

            raw_age = age_minutes(raw_ts)
            feature_age = age_minutes(feature_ts)

            freshness.append(
                {
                    'symbol': symbol,
                    'raw_timestamp': raw_ts.isoformat() if raw_ts else None,
                    'feature_timestamp': feature_ts.isoformat() if feature_ts else None,
                    'raw_age_minutes': raw_age,
                    'feature_age_minutes': feature_age,
                }
            )

        return freshness
    
    def save_ohlcv_data(self, symbol: str, timeframe: str, df: pd.DataFrame, source: str = 'csv'):
        """
        Save OHLCV data to database
        
        Args:
            symbol: Trading symbol
            timeframe: Timeframe ('1d', '4h', '2h', '1h', '30m')
            df: DataFrame with OHLCV data (index must be datetime)
            source: Data source ('csv', 'yahoo', 'api', etc.)
        """
        if df is None or df.empty:
            print(f"⚠️ No data to save for {symbol} {timeframe}")
            return
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        success_count = 0
        error_count = 0
        
        for timestamp, row in df.iterrows():
            try:
                # Ensure timestamp is a datetime object
                if isinstance(timestamp, str):
                    timestamp = pd.to_datetime(timestamp)
                
                timestamp_str = timestamp.strftime('%Y-%m-%d %H:%M:%S')
                
                cursor.execute('''
                INSERT OR REPLACE INTO ohlcv_data 
                (symbol, timeframe, timestamp, open, high, low, close, volume, source)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                ''', (
                    symbol,
                    timeframe,
                    timestamp_str,
                    float(row['open']),
                    float(row['high']),
                    float(row['low']),
                    float(row['close']),
                    int(row.get('volume', 0)),
                    source
                ))
                success_count += 1
                
            except Exception as e:
                error_count += 1
                if error_count <= 3:
                    print(f"❌ Error saving {symbol} {timeframe} data: {e}")
        
        conn.commit()
        conn.close()
        
        if success_count > 0:
            print(f"  ✅ Saved {success_count} records for {symbol} {timeframe}")
        if error_count > 0:
            print(f"  ⚠️ {error_count} errors during save")
    
    def load_ohlcv_data(self, symbol: str, timeframe: str, limit: int = None) -> Optional[pd.DataFrame]:
        """
        Load OHLCV data from database
        
        Args:
            symbol: Trading symbol
            timeframe: Timeframe ('1d', '4h', '2h', '1h', '30m')
            limit: Maximum number of records to return (most recent)
        
        Returns:
            DataFrame with OHLCV data or None
        """
        try:
            conn = sqlite3.connect(self.db_path)
            
            if limit:
                query = f'''
                SELECT timestamp, open, high, low, close, volume 
                FROM ohlcv_data 
                WHERE symbol = ? AND timeframe = ?
                ORDER BY timestamp DESC
                LIMIT {limit}
                '''
            else:
                query = '''
                SELECT timestamp, open, high, low, close, volume 
                FROM ohlcv_data 
                WHERE symbol = ? AND timeframe = ?
                ORDER BY timestamp ASC
                '''
            
            df = pd.read_sql_query(query, conn, params=(symbol, timeframe))
            conn.close()
            
            if df.empty:
                return None
            
            # Convert timestamp to datetime and set as index
            df['timestamp'] = pd.to_datetime(df['timestamp'])
            df = df.set_index('timestamp')
            
            # If we limited and ordered DESC, reverse to get ASC
            if limit:
                df = df.iloc[::-1]
            
            return df
            
        except Exception as e:
            print(f"❌ Error loading {symbol} {timeframe} data: {e}")
            return None
    
    def save_signal(self, symbol: str, timeframe: str, signal_type: str, 
                   confidence: float, price: float, indicators: Dict = None, 
                   cascade_data: Dict = None):
        """
        Save trading signal to database
        
        Args:
            symbol: Trading symbol
            timeframe: Timeframe
            signal_type: 'long', 'short', 'hold'
            confidence: Signal confidence (0-100)
            price: Entry price
            indicators: Dictionary of indicators
            cascade_data: Multi-timeframe cascade data
        """
        import json
        
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        try:
            cursor.execute('''
            INSERT INTO signals 
            (symbol, timeframe, signal_type, confidence, price, indicators, cascade_data, timestamp)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            ''', (
                symbol,
                timeframe,
                signal_type,
                confidence,
                price,
                json.dumps(indicators) if indicators else None,
                json.dumps(cascade_data) if cascade_data else None,
                datetime.now().strftime('%Y-%m-%d %H:%M:%S')
            ))
            
            conn.commit()
            
        except Exception as e:
            print(f"❌ Error saving signal: {e}")
        finally:
            conn.close()
    
    def get_recent_signals(self, symbol: str = None, limit: int = 10) -> List[Dict]:
        """
        Get recent signals from database
        
        Args:
            symbol: Filter by symbol (optional)
            limit: Number of signals to return
        
        Returns:
            List of signal dictionaries
        """
        import json
        
        conn = sqlite3.connect(self.db_path)
        
        if symbol:
            query = f'''
            SELECT * FROM signals 
            WHERE symbol = ?
            ORDER BY timestamp DESC
            LIMIT {limit}
            '''
            df = pd.read_sql_query(query, conn, params=(symbol,))
        else:
            query = f'''
            SELECT * FROM signals 
            ORDER BY timestamp DESC
            LIMIT {limit}
            '''
            df = pd.read_sql_query(query, conn)
        
        conn.close()
        
        signals = []
        for _, row in df.iterrows():
            signal = row.to_dict()
            if signal.get('indicators'):
                signal['indicators'] = json.loads(signal['indicators'])
            if signal.get('cascade_data'):
                signal['cascade_data'] = json.loads(signal['cascade_data'])
            signals.append(signal)
        
        return signals
    
    def get_database_stats(self) -> Dict:
        """
        Get database statistics
        
        Returns:
            Dictionary with database stats
        """
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        stats = {}
        
        # Count records by symbol and timeframe
        cursor.execute('''
        SELECT symbol, timeframe, COUNT(*) as count
        FROM ohlcv_data
        GROUP BY symbol, timeframe
        ''')
        
        stats['records_by_symbol_tf'] = {}
        for row in cursor.fetchall():
            key = f"{row[0]}_{row[1]}"
            stats['records_by_symbol_tf'][key] = row[2]
        
        # Total signals
        cursor.execute('SELECT COUNT(*) FROM signals')
        stats['total_signals'] = cursor.fetchone()[0]
        
        # Database file size
        db_path = Path(self.db_path)
        if db_path.exists():
            stats['db_size_mb'] = db_path.stat().st_size / (1024 * 1024)
        
        conn.close()
        
        return stats
    
    def get_signal_counts_24h(self) -> Dict:
        """
        Get signal counts in the last 24 hours by trigger type
        
        Returns:
            Dictionary with signal counts: {total, time, event}
        """
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        counts = {'total': 0, 'time': 0, 'event': 0}
        
        try:
            # Get timestamp for 24 hours ago
            from datetime import datetime, timedelta
            timestamp_24h_ago = (datetime.utcnow() - timedelta(hours=24)).strftime('%Y-%m-%d %H:%M:%S')
            
            # Total signals in last 24h
            cursor.execute('''
            SELECT COUNT(*) FROM ml_signals
            WHERE timestamp > ?
            ''', (timestamp_24h_ago,))
            counts['total'] = cursor.fetchone()[0]
            
            # Time-based signals (triggered_by = 'time')
            cursor.execute('''
            SELECT COUNT(*) FROM ml_signals
            WHERE timestamp > ? AND triggered_by = 'time'
            ''', (timestamp_24h_ago,))
            counts['time'] = cursor.fetchone()[0]
            
            # Event-driven signals (triggered_by starts with 'event:')
            cursor.execute('''
            SELECT COUNT(*) FROM ml_signals
            WHERE timestamp > ? AND triggered_by LIKE 'event:%'
            ''', (timestamp_24h_ago,))
            counts['event'] = cursor.fetchone()[0]
            
        except Exception as e:
            logging.getLogger(__name__).error(f"Error getting signal counts: {e}")
        
        finally:
            conn.close()
        
        return counts
    
    def clear_old_data(self, days: int = 90):
        """
        Clear data older than specified days
        
        Args:
            days: Keep data from last N days
        """
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        
        cutoff_date = (datetime.now() - pd.Timedelta(days=days)).strftime('%Y-%m-%d')
        
        cursor.execute('''
        DELETE FROM ohlcv_data
        WHERE timestamp < ?
        ''', (cutoff_date,))
        
        deleted = cursor.rowcount
        conn.commit()
        conn.close()
        
        print(f"✅ Deleted {deleted} old records (older than {days} days)")
    
