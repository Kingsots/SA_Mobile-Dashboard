    async def eod_pipeline_job(self):
        """
        End-of-day pipeline job
        
        Tasks:
        1. Generate features for all symbols
        2. Train/retrain XGBoost model
        3. Cleanup old data (>90 days)
        4. Send summary report
        """
        logger.info(f"🌙 Starting EOD pipeline job")
        
        if not Config.USE_TIINGO_PIPELINE:
            logger.info(f"⚠️  ML pipeline disabled - skipping EOD job")
            return
        
        summary = {
            'features_generated': 0,
            'model_trained': False,
            'model_accuracy': 0.0,
            'data_cleaned': 0,
            'errors': []
        }
        
        try:
            # 1. Generate features for all active crypto symbols
            #    (15m, 30m, 1h — Pulse/Rift universe via active_watchlist)
            #    (5m — Flow universe via flow_watchlist eligible symbols)
            logger.info(f"1️⃣  Generating features...")
            try:
                # Pulse/Rift intervals — active watchlist symbols
                active = self.scanner.get_active_symbols()
                crypto_syms = [s["symbol"] for s in active] if active else None
                results_1h = self.feature_engine.process_all_tickers(
                    '1h', symbols=crypto_syms
                )
                results_30m = self.feature_engine.process_all_tickers(
                    '30m', symbols=crypto_syms
                )
                results_15m = self.feature_engine.process_all_tickers(
                    '15m', symbols=crypto_syms
                )
                # Flow intervals — Flow-eligible symbols only
                # Uses flow_watchlist, NOT active_watchlist
                # 15m AND 5m both required for Flow IGNITE engine
                flow_syms = self.db.get_flow_eligible_symbols()
                results_5m = self.feature_engine.process_all_tickers(
                    '5m', symbols=flow_syms if flow_syms else None
                )
                results_15m_flow = self.feature_engine.process_all_tickers(
                    '15m', symbols=flow_syms if flow_syms else None
                )
                total = (len(results_1h) + len(results_30m)
                         + len(results_15m) + len(results_5m)
                         + len(results_15m_flow))
                summary['features_generated'] = total
                logger.info(
                    f"   ✅ Features: {len(results_1h)} (1h) "
                    f"+ {len(results_30m)} (30m) "
                    f"+ {len(results_15m)} (15m Pulse/Rift) "
                    f"+ {len(results_5m)} (5m Flow) "
                    f"+ {len(results_15m_flow)} (15m Flow)"
                )
            except Exception as e:
                logger.error(f"   ❌ Feature generation failed: {e}")
                summary['errors'].append(f"Features: {str(e)}")
            
            # 2. Train model
            logger.info(f"2️⃣  Training XGBoost model...")
            try:
                trainer = XGBTrainer()
                model = trainer.train_pipeline(interval='1h', days=90)
                
                if model:
                    summary['model_trained'] = True
                    # Get accuracy from metadata
                    import json
                    with open(Config.MODEL_METADATA_PATH, 'r') as f:
                        metadata = json.load(f)
                        summary['model_accuracy'] = metadata['metrics']['accuracy']
                    logger.info(f"   ✅ Model trained: {summary['model_accuracy']:.2%} accuracy")
                else:
                    logger.warning(f"   ⚠️  Model not deployed (accuracy < threshold)")
            except Exception as e:
                logger.error(f"   ❌ Model training failed: {e}")
                summary['errors'].append(f"Training: {str(e)}")
            
            # 3. Cleanup old data
            logger.info(f"3️⃣  Cleaning up old data...")
            try:
                self.db.cleanup_old_data(days=90)
                logger.info(f"   ✅ Cleanup complete")
            except Exception as e:
                logger.error(f"   ❌ Cleanup failed: {e}")
                summary['errors'].append(f"Cleanup: {str(e)}")
            
            # 4. Compute Flow watchlist eligibility
            logger.info(f"4️⃣  Computing Flow watchlist...")
            try:
                await self._compute_flow_watchlist_job()
                logger.info(f"   ✅ Flow watchlist computed")
            except Exception as e:
                logger.error(f"   ❌ Flow watchlist failed: {e}")
                summary['errors'].append(f"FlowWatchlist: {str(e)}")

            # 5. Send summary report
            if self.telegram_bot and Config.TELEGRAM_SEND_EOD_REPORTS:
                status_emoji = "✅" if len(summary['errors']) == 0 else "⚠️"
                message = (
                    f"{status_emoji} <b>EOD Pipeline Report</b>\n\n"
                    f"<b>Features Generated:</b> {summary['features_generated']} symbols\n"
                    f"<b>Model Training:</b> {'✅ Success' if summary['model_trained'] else '❌ Failed'}\n"
                    f"<b>Model Accuracy:</b> {summary['model_accuracy']:.1%}\n"
                    f"<b>Data Cleanup:</b> ✅ Complete\n"
                )
                
                if summary['errors']:
                    message += f"\n<b>Errors:</b> {len(summary['errors'])}\n"
                    for error in summary['errors'][:3]:  # Show first 3 errors
                        message += f"  • {error}\n"
                
                await _run_blocking(self.telegram_bot.send_message, message)
            
            logger.info(f"✅ EOD pipeline complete")
        
        except Exception as e:
            logger.error(f"❌ EOD pipeline failed: {e}")
            raise
    
    def generate_health_report(self) -> str:
        """
        Generate professional health report in specified format.
        
        Returns:
            Formatted health report string ready for Telegram
        """
        from datetime import datetime, timezone, timedelta
        import sqlite3
        import os
        
        now = datetime.now(timezone.utc)
        timestamp_utc = now.strftime('%Y-%m-%d %H:%M UTC')
        
        # Query V1 and V2 signals (last 24h)
        v1_count = 0
        v2_count = 0
        try:
            v1_result = self.db.execute_query(
                "SELECT COUNT(*) FROM ml_signals WHERE triggered_by='strategy_core_v1' AND datetime(timestamp) > datetime('now', '-1 day')"
            )
            v1_count = v1_result[0][0] if v1_result else 0
            
            v2_result = self.db.execute_query(
                "SELECT COUNT(*) FROM ml_signals WHERE triggered_by='v2_state_machine' AND datetime(timestamp) > datetime('now', '-1 day')"
            )
            v2_count = v2_result[0][0] if v2_result else 0
        except Exception as e:
            logger.debug(f"Could not query signal counts: {e}")
        
        total_count = v1_count + v2_count
        
        # Query V2 strategy state breakdown
        stage_1a = []
        stage_1b = []
        stage_1c = []
        stage_2 = []
        scanning = []
        
        try:
            conn = sqlite3.connect(Config.DB_PATH)
            cur = conn.cursor()
            cur.execute('''
                SELECT ticker, interval,
                       bull_entry_armed, bear_entry_armed,
                       bull_retest_done, bear_retest_done,
                       bull_break_bar, bear_break_bar,
                       bull_extreme_visited, bear_extreme_visited
                FROM strategy_state
                ORDER BY ticker, interval
            ''')
            rows = cur.fetchall()
            conn.close()
            
            for row in rows:
                (ticker, interval, bull_entry_armed, bear_entry_armed,
                 bull_retest_done, bear_retest_done,
                 bull_break_bar, bear_break_bar,
                 bull_extreme_visited, bear_extreme_visited) = row
                
                sym_key = f"{ticker}({interval})"
                
                if bull_entry_armed or bear_entry_armed:
                    stage_2.append(sym_key)
                elif bull_retest_done or bear_retest_done:
                    stage_1c.append(sym_key)
                elif (bull_break_bar is not None) or (bear_break_bar is not None):
                    stage_1b.append(sym_key)
                elif bull_extreme_visited or bear_extreme_visited:
                    stage_1a.append(sym_key)
                else:
                    scanning.append(sym_key)
        except Exception as e:
            logger.debug(f"Could not query V2 state: {e}")
        
        # Format symbols (≤5 show all, >5 show first 3 + count)
        def format_symbols(syms):
            if len(syms) == 0:
                return "(none)"
            elif len(syms) <= 5:
                return ", ".join(sorted(syms))
            else:
                first_3 = sorted(syms)[:3]
                remaining = len(syms) - 3
                return f"{', '.join(first_3)} +{remaining} more"
        
        stage_1a_formatted = format_symbols(stage_1a)
        stage_1b_formatted = format_symbols(stage_1b)
        stage_1c_formatted = format_symbols(stage_1c)
        stage_2_formatted = format_symbols(stage_2)
        
        # Get database info
        db_size_mb = 0
        try:
            if os.path.exists(Config.DB_PATH):
                db_size_mb = os.path.getsize(Config.DB_PATH) / (1024 * 1024)
        except:
            pass
        
        # Get last signal timestamp
        last_signal_time = "N/A"
        try:
            last_sig = self.db.execute_query(
                "SELECT timestamp FROM ml_signals ORDER BY timestamp DESC LIMIT 1"
            )
            if last_sig:
                last_ts = pd.Timestamp(last_sig[0][0])
                last_signal_time = last_ts.strftime('%H:%M UTC')
        except:
            pass
        
        # Get 24h signal count
        signals_24h = total_count
        
        # Calculate total active stages
        total_active_stages = len(stage_1a) + len(stage_1b) + len(stage_1c) + len(stage_2)
        
        # Determine health status
        health_emoji = "✅"
        engine_emoji = "🟢"
        if v1_count == 0 and v2_count == 0:
            health_warning = "\n⚠️  No signals generated in last 24h"
        else:
            health_warning = ""
        
        # Build report
        report = f"""{"─" * 40}
🏥 SILENT ANALYST HEALTH REPORT
{"─" * 40}
📅 {timestamp_utc}

{"━" * 40}
📊 SIGNAL PERFORMANCE (24h)
{"━" * 40}
🔮 V1 (5-Condition):  {v1_count:>3} signals
⚙️  V2 (RSI Machine):  {v2_count:>3} signals
📈 Total Generated:    {total_count:>3} signals{health_warning}

{"━" * 40}
📈 V2 STATE MACHINE (42 Pairs Total)
{"━" * 40}

🎯 STAGE 1A - Extreme Visit
   Count: {len(stage_1a):>2}
   Symbols: {stage_1a_formatted}

🔄 STAGE 1B - RSI Break
   Count: {len(stage_1b):>2}
   Symbols: {stage_1b_formatted}

✔️  STAGE 1C - Retest Complete
   Count: {len(stage_1c):>2}
   Symbols: {stage_1c_formatted}

🚪 STAGE 2 - Entry Window Armed ⚡
   Count: {len(stage_2):>2}
   Active: {stage_2_formatted}

🔍 SCANNING
   Count: {len(scanning):>2}

{"━" * 40}
💾 SYSTEM STATUS
{"━" * 40}
Database:  {db_size_mb:.0f}MB │ Signals: {signals_24h:>3}
Health:    {health_emoji} HEALTHY  │ Engine:  {engine_emoji} ACTIVE

{"━" * 40}
📋 QUICK SUMMARY
{"━" * 40}
- {len(stage_2)} pairs ready for entry confirmation
- {total_active_stages} total pairs tracked in V2
- Next signal: When Stage 2 EMA break occurs
- Last signal: {last_signal_time}

{"─" * 40}"""
        
        return report
    
    async def health_check_job(self):
        """
        System health check - runs 4× daily (every 6 hours).
        
        Generates and sends professional health report to Telegram.
        Also expires old trades automatically to prevent system lockup.
        """
        from datetime import datetime, timezone
        
        now = datetime.now(timezone.utc)
        logger.info("=" * 60)
        logger.info(f"🏥 HEALTH CHECK STARTED: {now.strftime('%Y-%m-%d %H:%M UTC')}")
        logger.info("=" * 60)
        
        try:
            # === AUTOMATIC TRADE EXPIRATION (prevent system lockup) ===
            expired_count = self.db.expire_old_trades(
                hours_30m=24,  # Close 30m trades after 24 hours
                hours_1h=48,   # Close 1h trades after 48 hours
                hours_4h=72,   # Close 4h trades after 72 hours
            )
            if expired_count > 0:
                logger.info(f"[TRADE_LIFECYCLE] Expired {expired_count} old trade(s) in this health check")
            
            # Generate professional health report
            report = self.generate_health_report()
            
            # Log to console
            logger.info("\n" + report)
            
            # Send to Telegram if enabled
            if self.enable_telegram and Config.TELEGRAM_SEND_HEALTH_REPORTS:
                try:
                    await _run_blocking(self.telegram_bot.send_message, report)
                    logger.info("✅ Health report sent to Telegram")
                except Exception as e:
                    logger.error(f"Failed to send health report to Telegram: {e}")
            
            logger.info("=" * 60)
            logger.info("🏥 HEALTH CHECK COMPLETED")
            logger.info("=" * 60)
            
        except Exception as e:
            logger.error(f"Health check failed: {e}", exc_info=True)
            
            # Send error alert to Telegram
            if self.enable_telegram and Config.TELEGRAM_SEND_ERROR_ALERTS:
                try:
                    await _run_blocking(
                        self.telegram_bot.send_message,
                        f"🚨 HEALTH CHECK FAILED\n\n"
                        f"Error: {str(e)}\n"
                        f"Time: {now.strftime('%Y-%m-%d %H:%M UTC')}\n\n"
                        f"Check logs immediately!"
                    )
                except:
                    pass
    
    # Heartbeat job removed - not needed at the moment (was writing logs/last_heartbeat.txt every 5 min)
    
    # ==========================================
    # SCHEDULER CONFIGURATION
    # ==========================================
    

    async def fetch_bybit_data(self, interval: str, symbols=None):
        """Fetch Bybit futures OHLCV for active watchlist symbols."""
        try:
            active = self.scanner.get_active_symbols()
            target_symbols = symbols or [a["symbol"] for a in active]
            # Protect OHLCV for symbols with unresolved signals regardless of watchlist
            unresolved = self.db.get_unresolved_signal_tickers()
            if unresolved:
                target_symbols = list(set(target_symbols) | set(unresolved))
            if not target_symbols:
                target_symbols = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT"]

            async with BybitFuturesFetcher() as fetcher:
                results = await fetcher.fetch_batch(
                    interval=interval,
                    symbols=target_symbols,
                    limit=200,
                    save_to_db=True
                )
            logger.info(
                f"[BYBIT_FETCH] {interval}: {len(results)}/{len(target_symbols)} symbols fetched"
            )
        except Exception as e:
            logger.error(f"[BYBIT_FETCH] Error fetching {interval}: {e}", exc_info=True)

    async def run_watchlist_scan(self, refresh_type: str = "intraday"):
        """Run daily scanner and update active watchlist."""
        try:
            summary = await self.scanner.run_scan(refresh_type=refresh_type)
            logger.info(
                f"[WATCHLIST] Scan complete: {summary.get('total_assets', 0)} assets, "
                f"bias={summary.get('sentiment_bias', 'N/A')}"
            )

            # Send summary to private Telegram bot
            await self._send_watchlist_to_private_bot(summary)

        except Exception as e:
            logger.error(f"[WATCHLIST] Scan error: {e}", exc_info=True)

    async def _send_watchlist_to_private_bot(self, summary: dict):
        """Send watchlist scan summary to private Telegram bot."""
        if not Config.WATCHLIST_TELEGRAM_ENABLED:
            return
        if not Config.PRIVATE_BOT_TOKEN or not Config.PRIVATE_BOT_CHAT_ID:
            return
        try:
            import aiohttp
            longs  = summary.get("long_symbols", [])
            shorts = summary.get("short_symbols", [])
            bias   = summary.get("sentiment_bias", "N/A")
            total  = summary.get("total_assets", 0)
            fallback = "⚠️ FALLBACK ACTIVE" if summary.get("fallback_activated") else ""

            message = (
                f"📊 *WATCHLIST UPDATE*\n"
                f"`{summary.get('timestamp', '')[:16]} UTC`\n\n"
                f"*Total Assets:* {total}  {fallback}\n"
                f"*Sentiment:* {bias}\n\n"
                f"🟢 *LONGS ({len(longs)}):*\n"
                f"`{chr(10).join(longs) if longs else 'None'}`\n\n"
                f"🔴 *SHORTS ({len(shorts)}):*\n"
                f"`{chr(10).join(shorts) if shorts else 'None'}`"
            )

            url = f"https://api.telegram.org/bot{Config.PRIVATE_BOT_TOKEN}/sendMessage"
            payload = {
                "chat_id":    Config.PRIVATE_BOT_CHAT_ID,
                "text":       message,
                "parse_mode": "Markdown"
            }

            async with aiohttp.ClientSession() as session:
                async with session.post(url, json=payload) as resp:
                    if resp.status == 200:
                        logger.info("[WATCHLIST] Summary sent to private bot")
                    else:
                        logger.warning(f"[WATCHLIST] Private bot send failed: {resp.status}")
        except Exception as e:
            logger.error(f"[WATCHLIST] Private bot error: {e}")


    def _fetch_bybit_wrapper(self, interval: str):
        """Sync wrapper for async bybit fetch - runs in new loop"""
        try:
            import asyncio
            new_loop = asyncio.new_event_loop()
            asyncio.set_event_loop(new_loop)
            try:
                new_loop.run_until_complete(self.fetch_bybit_data(interval))
            finally:
                new_loop.close()
        except Exception as e:
            logger.error(f"Bybit wrapper error: {e}", exc_info=True)

    def _fetch_bybit_5m_wrapper(self):
        """Sync wrapper for 5m Flow fetch — uses flow_eligible_symbols, not active watchlist."""
        try:
            import asyncio
            flow_symbols = self.db.get_flow_eligible_symbols()
            if not flow_symbols:
                logger.warning("[BYBIT_5M] No flow eligible symbols — skipping")
                return
            new_loop = asyncio.new_event_loop()
            asyncio.set_event_loop(new_loop)
            try:
                new_loop.run_until_complete(
                    self.fetch_bybit_data("5m", symbols=flow_symbols)
                )
            finally:
                new_loop.close()
        except Exception as e:
            logger.error(f"Bybit 5m wrapper error: {e}", exc_info=True)

    def _watchlist_scan_wrapper(self, refresh_type: str = "intraday"):
        """Sync wrapper for async watchlist scan - runs in new loop"""
        try:
            import asyncio
            new_loop = asyncio.new_event_loop()
            asyncio.set_event_loop(new_loop)
            try:
                new_loop.run_until_complete(self.run_watchlist_scan(refresh_type))
            finally:
                new_loop.close()
        except Exception as e:
            logger.error(f"Watchlist scan wrapper error: {e}", exc_info=True)

    def _crypto_signals_wrapper(self, interval: str):
        """Sync wrapper for async crypto signals - runs in new loop"""
        try:
            import asyncio
            new_loop = asyncio.new_event_loop()
            asyncio.set_event_loop(new_loop)
            # Rebind the shared asyncio.Lock to the new loop.
            # asyncio.Lock._loop is set permanently on first acquire; after the
            # previous loop closes, any subsequent loop triggers
            # "bound to a different event loop". Reinitialising here is safe
            # because max_instances=1 + coalesce=True already serialise
            # same-interval concurrent calls at the APScheduler level.
            self._signal_engine_lock = asyncio.Lock()
            try:
                new_loop.run_until_complete(self.generate_crypto_signals_job(interval))
            finally:
                new_loop.close()
        except Exception as e:
            logger.error(f"Crypto signals wrapper error: {e}", exc_info=True)

    async def generate_crypto_signals_job(self, interval: str):
        """Generate crypto signals using active_watchlist symbols"""
        try:
            logger.info(f"📊 Generating crypto signals for {interval}")
            active = self.scanner.get_active_symbols()
            symbols = [s["symbol"] for s in active] if active else None
            logger.info(f"   Symbols from active_watchlist: {symbols}")
            await self.generate_signals_job(interval, symbols=symbols)
        except Exception as e:
            logger.error(f"Error generating crypto signals for {interval}: {e}", exc_info=True)

    async def _send_crypto_signal_to_private_bot(self, symbol: str, signal_data: dict):
        """Send crypto signal to private bot"""
        try:
            logger.info(f"📤 Sending crypto signal for {symbol}: {signal_data}")
            # Implementation for sending to Telegram private bot
            # This should use the TelegramBot instance
            if hasattr(self, 'telegram_bot') and self.telegram_bot:
                await self.telegram_bot.send_signal(symbol, signal_data)
        except Exception as e:
            logger.error(f"Error sending crypto signal: {e}", exc_info=True)

    def _flow_ignite_job(self):
        """
        Flow IGNITE scan -- fires on every 15m candle close.
        Scans all Flow-eligible symbols for body-break signals.

        Synchronous -- _run_flow_ignite_scan() uses sync DB methods.
        No event loop required.

        Telegram broadcast is handled in Brief 6D.
        This job writes to ml_signals only.
        """
        try:
            if not Config.FLOW_ENGINE_ENABLED:
                return

            flow_symbols = self.db.get_flow_eligible_symbols()
            if not flow_symbols:
                logger.warning(
                    "[FLOW-IGNITE] No eligible symbols in flow_watchlist -- "
                    "skipping scan"
                )
                return

            fired   = 0
            scanned = 0

            for symbol in flow_symbols:
                scanned += 1
                result = self.signal_engine._run_flow_ignite_scan(
                    symbol, Config.FLOW_PRIMARY_INTERVAL
                )
                if result:
                    fired += 1

            if fired > 0:
                logger.info(
                    f"[FLOW-IGNITE] Scan complete -- "
                    f"{scanned} symbols scanned | "
                    f"{fired} signal(s) fired"
                )
            else:
                logger.debug(
                    f"[FLOW-IGNITE] Scan complete -- "
                    f"{scanned} symbols | no signals"
                )

        except Exception as e:
            logger.error(
                f"[FLOW-IGNITE] Job error: {e}",
                exc_info=True
            )

    async def _compute_flow_watchlist_job(self):
        """
        Compute Flow watchlist eligibility for all active
        crypto symbols. Runs nightly after features.
        Writes ALL symbols to flow_watchlist with
        excluded flag set for ineligible instruments.
        Eligible symbols (excluded=0) are used by the
        Flow scanner on every 15m scan cycle.
        """
        try:
            import sqlite3
            logger.info("[FLOW_WATCHLIST] Starting eligibility computation")

            # Query ohlcv_data for all symbols with recent 30m data
            conn = sqlite3.connect(Config.DB_PATH)
            query = """
                SELECT
                    symbol,
                    COUNT(*) as bar_count,
                    AVG(close) as avg_close,
                    AVG(
                        CASE WHEN ABS(close-open) > 0
                        THEN ((high-low) - ABS(close-open))
                             / ABS(close-open)
                        ELSE NULL END
                    ) as avg_wick_ratio,
                    AVG(high - low) as avg_range,
                    MAX(high) as max_close,
                    MIN(low)  as min_close,
                    AVG(volume) as avg_volume
                FROM ohlcv_data
                WHERE timeframe = '30m'
                  AND timestamp >= datetime('now', '-30 days')
                GROUP BY symbol
                HAVING bar_count >= 50
            """
            df = pd.read_sql_query(query, conn)
            conn.close()

            if df.empty:
                logger.warning(
                    "[FLOW_WATCHLIST] No ohlcv_data found — aborting"
                )
                return

            # Compute derived eligibility metrics
            df['daily_atr_est_pct'] = (
                df['avg_range'] / df['avg_close'] * 100 * 20
            )
            df['range_30bar_pct'] = (
                (df['max_close'] - df['min_close'])
                / df['min_close'] * 100
            )

            # Compute flow_score composite (0-10)
            # 4 pts: wick quality (lower wick ratio = better)
            # 3 pts: volatility (higher daily ATR = better)
            # 3 pts: range breadth (higher range = better)
            df['flow_score'] = 0.0
            df['flow_score'] += (
                4.0 * (1.0 - (
                    df['avg_wick_ratio'].clip(0, 4) / 4.0
                ))
            )
            df['flow_score'] += (
                3.0 * (
                    df['daily_atr_est_pct'].clip(0, 10) / 10.0
                )
            )
            df['flow_score'] += (
                3.0 * (
                    df['range_30bar_pct'].clip(0, 30) / 30.0
                )
            )
            df['flow_score'] = df['flow_score'].round(4)

            # ── MOMENTUM QUERY ────────────────────────────────────
            # Fetch today's day_open and current close per symbol.
            # UTC calendar day open = first 30m bar after 00:00 UTC.
            # Separate from the 30-day aggregate query above.
            # Mirrors DailyScanner change_from_open_pct computation.
            momentum_conn = sqlite3.connect(Config.DB_PATH)
            momentum_query = """
                SELECT
                    symbol,
                    MIN(CASE
                        WHEN TIME(timestamp) >= '00:00:00'
                         AND DATE(timestamp) = DATE('now')
                        THEN open END)      AS day_open,
                    MAX(CASE
                        WHEN DATE(timestamp) = DATE('now')
                        THEN close END)     AS current_close
                FROM ohlcv_data
                WHERE timeframe = '30m'
                  AND DATE(timestamp) = DATE('now')
                GROUP BY symbol
                HAVING day_open IS NOT NULL
                   AND current_close IS NOT NULL
            """
            momentum_df = pd.read_sql_query(
                momentum_query, momentum_conn
            )
            momentum_conn.close()

            # Build lookup: symbol -> change_from_open_pct
            momentum_map = {}
            for _, mrow in momentum_df.iterrows():
                if mrow['day_open'] and mrow['day_open'] != 0:
                    momentum_map[mrow['symbol']] = (
                        (mrow['current_close'] - mrow['day_open'])
                        / mrow['day_open'] * 100
                    )

            logger.info(
                f"[FLOW_WATCHLIST] Momentum data: "
                f"{len(momentum_map)} symbols with today's open"
            )

            # Apply eligibility filters — write ALL symbols
            # with excluded flag and reason for auditability
            exclusions = set(Config.FLOW_WATCHLIST_EXCLUSIONS)
            entries = []
            eligible_count = 0
            excluded_count = 0

            for _, row in df.iterrows():
                symbol = row['symbol']
                excluded = 0
                reason   = None

                if symbol in exclusions:
                    excluded = 1
                    reason   = 'NEGATIVE_EDGE'
                elif row['avg_wick_ratio'] > Config.FLOW_WICK_THRESHOLD:
                    excluded = 1
                    reason   = (
                        f'WICK_{row["avg_wick_ratio"]:.2f}'
                        f'>{Config.FLOW_WICK_THRESHOLD}'
                    )
                elif (row['daily_atr_est_pct']
                        < Config.FLOW_MIN_DAILY_ATR_PCT):
                    excluded = 1
                    reason   = (
                        f'ATR_{row["daily_atr_est_pct"]:.2f}'
                        f'<{Config.FLOW_MIN_DAILY_ATR_PCT}'
                    )
                elif (row['range_30bar_pct']
                        < Config.FLOW_MIN_RANGE_30BAR_PCT):
                    excluded = 1
                    reason   = (
                        f'RANGE_{row["range_30bar_pct"]:.2f}'
                        f'<{Config.FLOW_MIN_RANGE_30BAR_PCT}'
                    )
                elif symbol in momentum_map:
                    chg = momentum_map[symbol]
                    if abs(chg) < Config.FLOW_MIN_MOMENTUM_PCT:
                        excluded = 1
                        reason   = (
                            f'MOMENTUM_{chg:.2f}pct'
                            f'<{Config.FLOW_MIN_MOMENTUM_PCT}'
                        )

                if excluded == 0:
                    eligible_count += 1
                else:
                    excluded_count += 1

                entries.append({
                    'symbol':            symbol,
                    'wick_ratio':        round(
                        float(row['avg_wick_ratio']), 4
                    ),
                    'daily_atr_est_pct': round(
                        float(row['daily_atr_est_pct']), 4
                    ),
                    'range_30bar_pct':   round(
                        float(row['range_30bar_pct']), 4
                    ),
                    'avg_volume':        round(
                        float(row['avg_volume']), 2
                    ),
                    'bar_count':         int(row['bar_count']),
                    'flow_score':        float(row['flow_score']),
                    'excluded':          excluded,
                    'exclusion_reason':  reason,
                })

            written = self.db.save_flow_watchlist(entries)

            logger.info(
                f"[FLOW_WATCHLIST] Complete — "
                f"{written} symbols written | "
                f"{eligible_count} eligible | "
                f"{excluded_count} excluded"
            )

        except Exception as e:
            logger.error(
                f"[FLOW_WATCHLIST] Computation failed: {e}",
                exc_info=True
            )

    def register_jobs(self):
        """Register all scheduled jobs"""
        logger.info(f"📋 Registering scheduler jobs...")
        
        # Job 0: Heartbeat removed (not needed at the moment)
        

        # ── Bybit Futures fetch jobs ──────────────────────────────────────
        self.scheduler.add_job(
            self._fetch_bybit_5m_wrapper,
            trigger=CronTrigger(minute='*/5', timezone='UTC'),
            id="fetch_bybit_5m",
            name="Fetch Bybit 5m",
            max_instances=1,
            misfire_grace_time=30,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_5m (every 5 min)")

        # Flow IGNITE scan -- fires on 15m candle close
        # Same cadence as Bybit 15m fetch -- runs after data is fresh
        self.scheduler.add_job(
            self._flow_ignite_job,
            trigger=CronTrigger(
                minute='2,17,32,47', timezone='UTC'
            ),
            id='flow_ignite_15m',
            name='Flow IGNITE 15m Scan',
            replace_existing=True,
            max_instances=1,
            coalesce=True,
            misfire_grace_time=60,
        )
        logger.info(
            "   ✅ Job registered: flow_ignite_15m "
            "(every 15 min, Flow symbols)"
        )

        self.scheduler.add_job(
            lambda: self._fetch_bybit_wrapper("15m"),
            trigger=CronTrigger(minute='0,15,30,45', timezone='UTC'),
            id="fetch_bybit_15m",
            name="Fetch Bybit 15m",
            max_instances=1,
            misfire_grace_time=60,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_15m (every 15 min)")
        
        self.scheduler.add_job(
            lambda: self._fetch_bybit_wrapper("30m"),
            trigger=CronTrigger(minute='1,31', timezone='UTC'),
            id="fetch_bybit_30m",
            name="Fetch Bybit 30m",
            max_instances=1,
            misfire_grace_time=120,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_30m (every 30 min at :01/:31)")
        
        self.scheduler.add_job(
            lambda: self._fetch_bybit_wrapper("1h"),
            trigger=CronTrigger(minute='5', timezone='UTC'),
            id="fetch_bybit_1h",
            name="Fetch Bybit 1h",
            max_instances=1,
            misfire_grace_time=120,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_1h (every hour at :05)")
        
        self.scheduler.add_job(
            lambda: self._fetch_bybit_wrapper("2h"),
            trigger=CronTrigger(hour='*/2', minute='2', timezone='UTC'),
            id="fetch_bybit_2h",
            name="Fetch Bybit 2h",
            max_instances=1,
            misfire_grace_time=120,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_2h (every 2h at :02)")
        
        self.scheduler.add_job(
            lambda: self._fetch_bybit_wrapper("4h"),
            trigger=CronTrigger(hour='0,4,8,12,16,20', minute='3', timezone='UTC'),
            id="fetch_bybit_4h",
            name="Fetch Bybit 4h",
            max_instances=1,
            misfire_grace_time=300,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_4h (04:00,08:00,12:00,16:00,20:00 UTC at :03)")
        
        self.scheduler.add_job(
            lambda: self._run_async_safe(self.fetch_bybit_data("D")),
            trigger=CronTrigger(hour='0', minute='1', timezone='UTC'),
            id="fetch_bybit_daily",
            name="Fetch Bybit Daily",
            max_instances=1,
            misfire_grace_time=600,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: fetch_bybit_daily (daily at 00:01 UTC)")

        # ── Daily watchlist scanner jobs ──────────────────────────────────
        self.scheduler.add_job(
            lambda: self._run_async_safe(self.run_watchlist_scan("daily")),
            trigger=CronTrigger(hour='0', minute='2', timezone='UTC'),
            id="watchlist_scan_00",
            name="Daily Watchlist Scan (00:00)",
            max_instances=1,
            misfire_grace_time=300,
            coalesce=True
        )

        # ── Crypto signal generation jobs ────────────────────────────────
        self.scheduler.add_job(
            lambda: self._crypto_signals_wrapper("30m"),
            trigger=CronTrigger(minute="4,34", timezone="UTC"),
            id="crypto_signals_30m",
            name="Crypto Signals 30m",
            max_instances=1,
            misfire_grace_time=60,
            coalesce=True
        )
        logger.info("   ✅ Job registered: crypto_signals_30m (minute 20,50)")

        self.scheduler.add_job(
            lambda: self._crypto_signals_wrapper("1h"),
            trigger=CronTrigger(minute="8", timezone="UTC"),
            id="crypto_signals_1h",
            name="Crypto Signals 1h",
            max_instances=1,
            misfire_grace_time=120,
            coalesce=True
        )
        logger.info("   ✅ Job registered: crypto_signals_1h (hourly at :25)")

        self.scheduler.add_job(
            lambda: self._crypto_signals_wrapper("2h"),
            trigger=CronTrigger(hour="*/2", minute="5", timezone="UTC"),
            id="crypto_signals_2h",
            name="Crypto Signals 2h",
            max_instances=1,
            misfire_grace_time=180,
            coalesce=True
        )
        logger.info("   ✅ Job registered: crypto_signals_2h (every 2h at :35)")

        self.scheduler.add_job(
            lambda: self._crypto_signals_wrapper("4h"),
            trigger=CronTrigger(hour="0,4,8,12,16,20", minute="6", timezone="UTC"),
            id="crypto_signals_4h",
            name="Crypto Signals 4h",
            max_instances=1,
            misfire_grace_time=300,
            coalesce=True
        )
        logger.info("   ✅ Job registered: crypto_signals_4h (every 4h at :40)")

        logger.info(f"   ✅ Job registered: watchlist_scan_00 (daily at 00:02 UTC)")

        for scan_hour in [4, 8, 12, 16, 20]:
            self.scheduler.add_job(
                lambda h=scan_hour: self._watchlist_scan_wrapper("intraday"),
                trigger=CronTrigger(hour=str(scan_hour), minute='2', timezone='UTC'),
                id=f"watchlist_scan_{scan_hour:02d}",
                name=f"Intraday Watchlist Scan ({scan_hour:02d}:00)",
                max_instances=1,
                misfire_grace_time=300,
                coalesce=True
            )
            logger.info(f"   ✅ Job registered: watchlist_scan_{scan_hour:02d} (intraday at {scan_hour:02d}:02 UTC)")

        


        # Job 6a: Hourly watchlist scan (every hour at :05 UTC — new asset discovery between 4h scans)
        self.scheduler.add_job(
            lambda: self._watchlist_scan_wrapper("hourly"),
            trigger=CronTrigger(minute='5', timezone='UTC'),
            id='watchlist_scan_1h',
            name='Hourly Watchlist Scan',
            max_instances=1,
            misfire_grace_time=120,
            coalesce=True
        )
        logger.info(f"   ✅ Job registered: watchlist_scan_1h (every hour at :05 UTC)")

        # 30m watchlist scan -- added May 10 2026
        self.scheduler.add_job(
            self._watchlist_scan_wrapper,
            trigger='cron',
            minute='0,30',
            id='watchlist_scan_30m',
            name='Watchlist Scan 30m',
            replace_existing=True
        )
        logger.info("   ✅ Job registered: watchlist_scan_30m (every :00 and :30)")

        # Job 6: Health check every 6 hours at 00:12, 06:12, 12:12, 18:12 UTC (4× daily, 12min offset to avoid job collisions)
        self.scheduler.add_job(
            self.health_check_job,
            trigger=CronTrigger(hour='0,6,12,18', minute=12, timezone='UTC'),
            id='health_check',
            name='System Health Check',
            max_instances=1
        )
        logger.info(f"   ✅ Job registered: health_check (00:12, 06:12, 12:12, 18:12 UTC - 4× daily, race-safe offset)")
        
        # Job 7: Event deduplication cleanup (every 6 hours)
        self.scheduler.add_job(
            self._cleanup_old_event_ids,
            trigger=CronTrigger(minute=0, hour='*/6', timezone='UTC'),
            id='event_dedup_cleanup',
            name='Event Deduplication Cleanup',
            replace_existing=True
        )
        logger.info(f"   ✅ Job registered: event_dedup_cleanup (every 6h)")
        
        # Job 8: Data starvation monitor DISABLED
        # self.scheduler.add_job(
        #     self._check_data_starvation,
        #     trigger=IntervalTrigger(minutes=5),
        #     id='data_starvation_check',
        #     name='Data Starvation Monitor',
        #     max_instances=1,
        #     coalesce=True
        # )
        # logger.info(f"   ✅ Job registered: data_starvation_check (every 5 min, alerts if 45+ min without data)")
        logger.info(f"   ⏸️  Job DISABLED: data_starvation_check (not needed - user monitoring manually)")

        # Flow Watchlist: nightly eligibility computation at 23:05 UTC
        # Runs independently of eod_pipeline_job (which is unregistered)
        # Primary execution trigger for Flow watchlist refresh
        self.scheduler.add_job(
            self._compute_flow_watchlist_job,
            trigger=CronTrigger(hour=23, minute=5, timezone='UTC'),
            id='flow_watchlist_nightly',
            name='Flow Watchlist Eligibility Computation',
            replace_existing=True,
            max_instances=1,
            coalesce=True,
        )
        logger.info(
            "   ✅ Job registered: flow_watchlist_nightly "
            "(daily 23:05 UTC)"
        )
        
        
    
    def start(self):
        """Start the scheduler"""
        logger.info(f"\n{'='*70}")
        logger.info(f"  🚀 STARTING ML PIPELINE SCHEDULER")
        logger.info(f"{'='*70}\n")
        
        if not Config.USE_TIINGO_PIPELINE:
            logger.warning(f"⚠️  USE_TIINGO_PIPELINE = False")
            logger.warning(f"   Jobs will run but skip operations")
            logger.warning(f"   Set to True in core/config.py to enable\n")
        
        # Bootstrap strategy state (ensure all symbol×interval rows exist)
        logger.info(f"⚙️  Bootstrapping strategy_state table...")
        self.db.bootstrap_strategy_state()
        
        self.register_jobs()
        self.scheduler.start()
        
        # Print schedule
        self.print_schedule()
        
        logger.info(f"\n✅ Scheduler started - Press Ctrl+C to stop\n")
    
    def stop(self):
        """Stop the scheduler"""
        logger.info(f"🛑 Stopping scheduler...")
        self.scheduler.shutdown()
        logger.info(f"✅ Scheduler stopped")
    
    def print_schedule(self):
        """Print scheduled jobs"""
        logger.info(f"\n📅 Scheduled Jobs:")
        logger.info(f"{'='*70}")
        
        jobs = self.scheduler.get_jobs()
        for job in jobs:
            next_run = job.next_run_time
            logger.info(f"   {job.name}")
            logger.info(f"      Next run: {next_run}")
            logger.info(f"      Trigger: {job.trigger}")
        
        logger.info(f"{'='*70}\n")
    
    def get_job_stats(self):
        """Get job execution statistics"""
        return self.job_stats


async def main():
    """Run scheduler"""
    scheduler = MLPipelineScheduler(enable_telegram=True)
    
    try:
        scheduler.start()
        
        # Keep running
        while True:
            await asyncio.sleep(1)
    
    except KeyboardInterrupt:
        logger.info(f"\n⚠️  Keyboard interrupt received")
        scheduler.stop()
    
    except Exception as e:
        logger.error(f"❌ Scheduler error: {e}")
        scheduler.stop()


if __name__ == '__main__':
    asyncio.run(main())
