def verify_database_dependencies(db):
    """
    CRITICAL DEPENDENCY CHECK - Prevent silent trading engine paralysis
    
    Verifies that core database methods exist. If any are missing,
    system halts immediately instead of silently failing.
    
    This prevents the scenario where the database layer gets accidentally
    stripped of critical methods (like load_strategy_state), leaving
    the system running but unable to process signals.
    
    Args:
        db: DatabaseManager instance
        
    Raises:
        RuntimeError: If ANY required method is missing
    """
    required_methods = [
        "load_strategy_state",
        "save_strategy_state",
        "bootstrap_strategy_state",
        "is_event_processed",
        "mark_event_processed",
        "log_api_usage",
        "log_job_execution",
        "api_call_exists",  # API dedup safety
    ]
    
    missing = []
    for method_name in required_methods:
        if not hasattr(db, method_name) or not callable(getattr(db, method_name)):
            missing.append(method_name)
    
    if missing:
        error_msg = (
            f"\n🔴 CRITICAL SYSTEM FAILURE: Database layer incomplete\n"
            f"Missing methods: {', '.join(missing)}\n"
            f"This prevents signal generation and trading.\n"
            f"DO NOT CONTINUE - Restore core/database.py immediately.\n"
        )
        logger.critical(error_msg)
        raise RuntimeError(error_msg)
    
    logger.info(f"✅ Database dependency check passed - all {len(required_methods)} critical methods present")


