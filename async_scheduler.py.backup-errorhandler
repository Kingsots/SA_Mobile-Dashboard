    async def _check_data_starvation(self):
        """
        Monitor if OHLCV data ingestion is stalled.
        
        Alert if no new rows have been added to ohlcv_raw table in the last 45 minutes.
        This prevents the system from running silently on stale data all day.
        
        Implements cooldown to avoid spam (max 1 alert per hour).
        """
        try:
            now = datetime.now(timezone.utc)
            
            # Check if we're on cooldown from last alert
            if self._last_starvation_alert is not None:
                time_since_alert = now - self._last_starvation_alert
                if time_since_alert < self._starvation_alert_cooldown:
                    # Still in cooldown, skip check
                    return
            
            # Query the most recent OHLCV row
            try:
                import sqlite3
                conn = sqlite3.connect(Config.DB_PATH)
                cursor = conn.cursor()
                cursor.execute("SELECT MAX(timestamp) FROM ohlcv_data")
                result = cursor.fetchone()
                conn.close()
                
                if not result or not result[0]:
                    # No data in table yet
                    logger.debug("⚙️  Data starvation check: No data in ohlcv_data table yet")
                    return
                
                last_data_ts = pd.Timestamp(result[0])
                age_minutes = (now - last_data_ts).total_seconds() / 60
                
                # Alert threshold: 45 minutes
                if age_minutes > 45:
                    # Data is stale - send alert
                    alert_msg = (
                        f"⚠️ <b>Silent Analyst Health Alert</b>\n\n"
                        f"<b>Issue:</b> No market data received\n"
                        f"<b>Duration:</b> {age_minutes:.0f} minutes\n"
                        f"<b>Last Data:</b> {last_data_ts.strftime('%Y-%m-%d %H:%M UTC')}\n"
                        f"<b>Current Time:</b> {now.strftime('%Y-%m-%d %H:%M UTC')}\n"
                        f"<b>Action:</b> Check data ingestion pipeline\n\n"
                        f"<i>This alert fires every 1 hour max to avoid spam</i>"
                    )
                    
                    logger.warning(
                        f"🚨 DATA STARVATION ALERT: No new OHLCV data for {age_minutes:.0f}m "
                        f"(last: {last_data_ts.isoformat()})"
                    )
                    
                    # Send Telegram alert
                    if self.enable_telegram:
                        try:
                            await _run_blocking(self.telegram_bot.send_message, alert_msg)
                            self._last_starvation_alert = now
                            logger.info("✅ Data starvation alert sent to Telegram")
                        except Exception as e:
                            logger.error(f"❌ Failed to send starvation alert: {e}")
                    else:
                        # Even if Telegram disabled, mark that alert was "sent" to skip spamming logs
                        self._last_starvation_alert = now
                else:
                    # Data is fresh - log for reference
                    logger.debug(f"✅ Data freshness check: Latest OHLCV from {age_minutes:.0f}m ago")
            
            except Exception as e:
                logger.warning(f"⚠️  Error checking data starvation: {e}")
        
        except Exception as e:
            logger.error(f"❌ Unexpected error in data starvation check: {e}")

    def _should_run_time_based_fallback(self, symbol: str, now: datetime) -> bool:
        """
        Hybrid mode logic: Decide if time-based signal generation should run.
        
        Returns True if:
        - No event detected for this symbol in FALLBACK_HOURS (default 4h)
        - OR first time checking this symbol
        
        This ensures we don't miss valid setups when event detector is quiet.
        """
        last_event = self._last_event_time.get(symbol)
        if last_event is None:
            # First time seeing this symbol, allow time-based run
            return True
        
        hours_since_event = (now - last_event).total_seconds() / 3600
        should_run = hours_since_event >= self.FALLBACK_HOURS
        
        if should_run:
            logger.debug(f"   ⏳ {symbol}: {hours_since_event:.1f}h since last event → time-based fallback allowed")
        
        return should_run

