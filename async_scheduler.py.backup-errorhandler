    env_token = os.getenv('TIINGO_API_TOKEN')
    
    if not env_token:
        error_msg = (
            "\n🔴 CRITICAL TOKEN ERROR:\n"
            "   Environment variable TIINGO_API_TOKEN is not set.\n"
            "   Expected: /etc/opticore.env or systemd EnvironmentFile\n"
