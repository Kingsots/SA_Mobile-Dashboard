        logger.critical(error_msg)
        raise RuntimeError(error_msg)
    
    # Log masked token at startup
    logger.info(f"🔑 Tiingo API Token Loaded: {_mask_token(env_token)}")
    logger.info(f"✅ Token consistency verified - environment and config match")


