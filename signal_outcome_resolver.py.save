#!/usr/bin/env python3
import sqlite3, logging, sys
DB_PATH = "/home/ubuntu/SilentAnalyst/trading_bot.db"
LOOKBACK_BARS = 100
MIN_BARS = 10
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
logger = logging.getLogger(__name__)
JPY = ["CADJPY","GBPJPY","USDJPY","EURJPY","AUDJPY","NZDJPY","CHFJPY"]

def run():
    conn = sqlite3.connect(DB_PATH)
    for col,typ in [("outcome","TEXT"),("pl_usd","REAL")]:
        try:
            conn.execute(f"ALTER TABLE ml_signals ADD COLUMN {col} {typ}")
            conn.commit()
        except: pass
    rows = conn.execute("""SELECT id,ticker,interval,signal,entry_price,stop_loss,take_profit,created_at FROM ml_signals WHERE broadcasted=1 AND outcome IS NULL AND entry_price IS NOT NULL AND stop_loss IS NOT NULL AND take_profit IS NOT NULL AND created_at > datetime("now","-7 days") ORDER BY created_at ASC""").fetchall()
    logger.info(f"Found {len(rows)} signals")
    tp=sl=ex=pend=0
    for sid,ticker,interval,direction,entry,stop_loss,take_profit,created_at in rows:
    bars = conn.execute(" python3 << 'PYSCRIPT'
