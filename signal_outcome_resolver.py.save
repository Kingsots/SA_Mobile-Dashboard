ssh -i "C:\Users\bigso\Downloads\OptiCore-key.pem" ubuntu@44.220.160.173 "bash /tmp/apply_patch_remote.sh"
ssh -i "C:\Users\bigso\Downloads\OptiCore-key.pem" ubuntu@44.220.160.173 "bash -lc 'b=$(ls -1t /home/ubuntu/SilentAnalyst/signal_outcome_resolver.py.backup.* 2>/dev/null | head -n1); if [ -n \"$b\" ]; then cp -v \"$b\" /home/ubuntu/SilentAnalyst/signal_outcome_resolver.py ; echo RESTORED:\"$b\"; else echo NO_BACKUP_FOUND; fi; echo; echo VERIFY:; sed -n '20,24p' /home/ubuntu/SilentAnalyst/signal_outcome_resolver.py'"
SELECT high,low,close FROM ohlcv_data WHERE symbol=? AND timeframe=? AND timestamp>? ORDER BY timestamp ASC LIMIT ?, (ticker,interval,created_at.replace(chr(32),chr(84))++00:00,LOOKBACK_BARS)).fetchall()
        if len(bars) < MIN_BARS:
            conn.execute("UPDATE ml_signals SET outcome=? WHERE id=?",("PENDING",sid))
            pend+=1
            continue
        outcome=None
        pl_pips=0
        last_close=None
        for high,low,close in bars:
            last_close=close
            if direction==1:
                if high>=take_profit: outcome="TP_HIT"; pl_pips=take_profit-entry; break
                elif low<=stop_loss: outcome="SL_HIT"; pl_pips=stop_loss-entry; break
            elif direction==-1:
                if low<=take_profit: outcome="TP_HIT"; pl_pips=entry-take_profit; break
                elif high>=stop_loss: outcome="SL_HIT"; pl_pips=entry-stop_loss; break
        if outcome is None:
            outcome="EXPIRY"
            pl_pips=(last_close-entry) if direction==1 else (entry-last_close)
        if ticker=="XAUUSD": pl_usd=round(pl_pips*10*0.10,2)
        elif ticker in JPY: pl_usd=round(pl_pips*100*0.10,2)
        else: pl_usd=round(pl_pips*10000*0.10,2)
        conn.execute("UPDATE ml_signals SET outcome=?,pl_usd=? WHERE id=?",(outcome,pl_usd,sid))
        logger.info(f"Resolved {ticker} {interval} #{sid}: {outcome} ${pl_usd}")
        if outcome=="TP_HIT": tp+=1
        elif outcome=="SL_HIT": sl+=1
        elif outcome=="EXPIRY": ex+=1
    conn.commit()
    conn.close()
    logger.info(f"Done: {tp} TP_HIT, {sl} SL_HIT, {ex} EXPIRY, {pend} PENDING")

run()
